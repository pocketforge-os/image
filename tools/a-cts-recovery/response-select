#!/bin/sh
set -eu

label=${1:?field label}
pattern=${2:?anchored ERE}
input=${3:?response file}

[ -r "$input" ] || {
    printf 'A_CTS_RESPONSE_SELECT field=%s verdict=invalid reason=unreadable\n' "$label" >&2
    exit 64
}

awk -v field="$label" -v pattern="$pattern" '
    $0 ~ pattern { matches++; selected=$0 }
    END {
        if (matches != 1) {
            printf "A_CTS_RESPONSE_SELECT field=%s verdict=invalid matches=%d\n", field, matches > "/dev/stderr"
            exit(matches == 0 ? 65 : 66)
        }
        print selected
    }
' "$input"
