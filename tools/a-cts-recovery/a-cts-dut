empty_qpa_reset_selftest() {
    [ "${PF_ACTS_SELFTEST:-}" = 1 ] || die 'reason=selftest_only'
    mkdir -p "$ROOT/work" "$ROOT/harness-evidence/gate"
    : >"$ROOT/ledger.tsv"
    : >"$ROOT/qpa-manifest.tsv"
    : >"$ROOT/harness-errors.tsv"
    : >"$ROOT/work/empty.qpa"
    : >"$ROOT/work/empty.stdout"
    : >"$ROOT/work/empty.stderr"
    : >"$ROOT/work/reset.dmesg"
    empty_index=0
    for empty_outcome in recovered exhausted cap; do
        empty_matrix=0
        for empty_spec in '0 no' '1 no' '124 yes'; do
            empty_rc=${empty_spec%% *}
            empty_deadline=${empty_spec#* }
            empty_index=$((empty_index + 1))
            printf '%s\n' case.pending >"$ROOT/work/remaining-$empty_index"
            case "$empty_outcome" in
            recovered) empty_sanity=pass; empty_count=1; empty_expected=81 ;;
            exhausted) empty_sanity=fail; empty_count=1; empty_expected=77 ;;
            cap) empty_sanity=unknown; empty_count=$RECOVERY_RESET_CAP; empty_expected=80 ;;
            esac
            set +e
            commit_attempt gate 0000 "$empty_index" "$ROOT/work/remaining-$empty_index" \
                "$ROOT/work/empty.qpa" "$empty_rc" "$empty_deadline" \
                "$ROOT/work/empty.stdout" "$ROOT/work/empty.stderr" \
                2026-10-10T00:00:00Z 2026-10-10T00:00:01Z \
                "$ROOT/work/reset.dmesg" "$empty_sanity" yes "$empty_count"
            empty_actual=$?
            set -e
            [ "$empty_actual" -eq "$empty_expected" ] \
                || die "reason=empty_qpa_reset outcome=$empty_outcome rc=$empty_rc deadline=$empty_deadline expected=$empty_expected actual=$empty_actual"
            [ "$(cat "$ROOT/work/remaining-$empty_index")" = case.pending ] \
                || die "reason=empty_qpa_remaining outcome=$empty_outcome"
            empty_matrix=$((empty_matrix + 1))
        done
        [ "$empty_matrix" -eq 3 ] || die "reason=empty_qpa_matrix outcome=$empty_outcome"
    done
    [ ! -s "$ROOT/harness-errors.tsv" ] || die 'reason=empty_qpa_harness_error'
    [ ! -s "$ROOT/ledger.tsv" ] || die 'reason=empty_qpa_false_result'
    printf 'A_CTS_EMPTY_QPA_RESET_SELFTEST recovered_matrix=3 exhausted_matrix=3 cap_matrix=3 retry_rc=81 exhausted_rc=77 cap_rc=80 remaining=preserved harness_errors=0\n'
}

recovery_reason_selftest() {
