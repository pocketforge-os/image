    recovery-reason-selftest) recovery_reason_selftest ;;
    host-selftest) host_selftest ;;
    probe-selftest) probe_selftest ;;
    probe-discrim-fixture)
        [ "${PF_ACTS_SELFTEST:-}" = 1 ] || die 'reason=selftest_only'
        case "$arg" in 1|5) ;; *) die 'reason=selftest_budget' ;; esac
        fixture_sha=$(sha256sum "$DISCRIM_PROBE" | cut -d' ' -f1)
        probe_execute fixture discriminate-layout "$DISCRIM_PROBE" "$fixture_sha" "$arg" yes
        ;;
    probe-vk-fixture)
        [ "${PF_ACTS_SELFTEST:-}" = 1 ] || die 'reason=selftest_only'
        fixture_kind=${arg%%:*}; fixture_budget=${arg#*:}
        case "$fixture_kind:$fixture_budget" in vk-copy-layout:1|vk-copy-layout:5) ;; *) die 'reason=selftest_budget' ;; esac
        fixture_sha=$(sha256sum "$VK_PROBE" | cut -d' ' -f1)
        probe_execute fixture "$fixture_kind" "$VK_PROBE" "$fixture_sha" "$fixture_budget" yes
        ;;
    probe-run)
        probe_spec "$arg"
        probe_execute "$arg" "$arg" "$probe_path" "$expected_sha" "$budget" no
        ;;
    probe-start) probe_launch ;;
    probe-supervisor) probe_supervisor ;;
    probe-poll) probe_poll ;;
    probe-receipt)
        case "$arg" in default|etc-matrix|discriminate-layout|vk-copy-layout|vk-compute-layout|vk-compute-etc1) ;; *) die 'reason=probe_kind' ;; esac
        [ -r "$ROOT/probes/$arg/archive.receipt" ] || die 'reason=probe_archive_not_ready'
        cat "$ROOT/probes/$arg/archive.receipt" "$ROOT/probes/$arg/result.txt"
        ;;
    probe-chunk)
        probe_name=${arg%%:*}; probe_index=${arg#*:}
        case "$probe_name" in default|etc-matrix|discriminate-layout|vk-copy-layout|vk-compute-layout|vk-compute-etc1) ;; *) die 'reason=probe_kind' ;; esac
        case "$probe_index" in ''|*[!0-9]*) die 'reason=chunk_index' ;; esac
        probe_chunk=$ROOT/probes/$probe_name/archive-chunk.tmp
        dd if="$ROOT/probes/$probe_name/results.tar.gz" of="$probe_chunk" \
            bs=36000 skip="$probe_index" count=1 status=none
        printf 'sha256=%s bytes=%s\n' "$(sha256sum "$probe_chunk" | cut -d' ' -f1)" "$(wc -c <"$probe_chunk")"
        base64 -w0 "$probe_chunk"; printf '\n'
        find "$probe_chunk" -maxdepth 0 -type f -delete
        ;;
    egl-preflight) egl_preflight ;;
    egl-preflight-receipt)
        [ -r "$ROOT/egl-preflight/archive.receipt" ] || die 'reason=egl_preflight_archive_not_ready'
        cat "$ROOT/egl-preflight/archive.receipt" "$ROOT/egl-preflight/result.txt"
        ;;
    egl-preflight-chunk)
        case "$arg" in ''|*[!0-9]*) die 'reason=chunk_index' ;; esac
        egl_chunk=$ROOT/egl-preflight/archive-chunk.tmp
        dd if="$ROOT/egl-preflight/results.tar.gz" of="$egl_chunk" \
            bs=36000 skip="$arg" count=1 status=none
        printf 'sha256=%s bytes=%s\n' "$(sha256sum "$egl_chunk" | cut -d' ' -f1)" \
            "$(wc -c <"$egl_chunk")"
        base64 -w0 "$egl_chunk"; printf '\n'
        find "$egl_chunk" -maxdepth 0 -type f -delete
        ;;
    gpu-health) gpu_health ;;
    prepare) prepare_request; printf 'A_CTS_PREPARE state=complete cases=%s\n' "$(wc -l <"$ROOT/expected.tsv")" ;;
    worker-start)
        control_root=$ROOT
        worker_root=$ROOT/worker-run
        [ -s "$control_root/expected.tsv" ] || die 'reason=not_prepared'
        sudo -n /usr/bin/install -d -m 0755 -o gamer -g gamer "$worker_root"
        for item in a-cts-dut expected.tsv meta.tsv ledger.tsv qpa-manifest.tsv \
            crash-evidence.tsv gpu-reset-events.tsv harness-errors.tsv lists nonpass-qpa \
            crash-evidence gpu-reset-events harness-evidence; do
            [ ! -e "$control_root/$item" ] \
                || sudo -n /bin/cp -a "$control_root/$item" "$worker_root/"
        done
        sudo -n chown -R gamer:gamer "$worker_root"
        ROOT=$worker_root
        [ ! -e "$ROOT/worker.pid" ] || die 'reason=worker_already_started'
        sudo -n -u gamer env \
            HOME=/home/gamer USER=gamer LOGNAME=gamer PATH=/usr/local/bin:/usr/bin:/bin \
            XDG_RUNTIME_DIR=/run/user/1000 EGL_PLATFORM=surfaceless \
            PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1 \
            PF_ACTS_ROOT="$ROOT" \
            PF_ACTS_BUNDLE="$BUNDLE" \
            PF_ACTS_WORKER_FIXTURE="${PF_ACTS_WORKER_FIXTURE:-}" \
            PF_ACTS_R41_FINALIZE_DELAY="${PF_ACTS_R41_FINALIZE_DELAY:-}" \
            PF_ACTS_SANITY_PROBE="$SANITY_PROBE" \
            PF_ACTS_SANITY_PROBE_SHA="$SANITY_PROBE_SHA" \
            PF_ACTS_DMESG_FIXTURE="${PF_ACTS_DMESG_FIXTURE:-}" \
            "$ROOT/a-cts-dut" worker-launch >/dev/null 2>&1
        for _ in 1 2 3 4 5; do
            [ ! -s "$ROOT/worker.pid" ] || break
            [ ! -s "$ROOT/worker.exit" ] || break
            sleep 1
        done
        [ -s "$ROOT/worker.pid" ] || worker_failure worker_pid_missing
        pid=$(cat "$ROOT/worker.pid")
        sleep 2
        worker_alive "$pid" || worker_failure worker_not_alive
        printf 'A_CTS_WORKER state=started pid=%s\n' "$pid"
        ;;
    worker-launch) worker_launch ;;
    worker-supervisor) worker_supervisor ;;
    finalize-partial) finalize_partial "${arg:-manual}" ;;
    reseal) make_archive ;;
    worker-finalize)
        control_root=$ROOT
        ROOT=$ROOT/worker-run
        waited=no
        terminated=no
        if [ -r "$ROOT/worker.pid" ] || [ -r "$ROOT/worker.pgid" ]; then
            if ! { [ -r "$ROOT/worker.pid" ] && [ -r "$ROOT/worker.pgid" ]; }; then
                die 'reason=worker_identity_incomplete'
            fi
            pid=$(cat "$ROOT/worker.pid")
            pgid=$(cat "$ROOT/worker.pgid")
            [ "$pgid" = "$pid" ] || die "reason=worker_process_group pid=$pid pgid=$pgid"
            if worker_group_alive "$pgid"; then
                waited=yes
                wait_seconds=${PF_ACTS_FINALIZE_WAIT_SECONDS:-120}
                case "$wait_seconds" in ''|*[!0-9]*) die "reason=finalize_wait value=$wait_seconds" ;; esac
                elapsed=0
                while worker_group_alive "$pgid" && [ "$elapsed" -lt "$wait_seconds" ]; do
                    sleep 1
                    elapsed=$((elapsed + 1))
                done
                if worker_group_alive "$pgid"; then
                    terminated=yes
                    signal_worker_group TERM "$pgid"
                    term_grace=${PF_ACTS_TERM_GRACE_SECONDS:-10}
                    case "$term_grace" in ''|*[!0-9]*) die "reason=term_grace value=$term_grace" ;; esac
                    elapsed=0
                    while worker_group_alive "$pgid" && [ "$elapsed" -lt "$term_grace" ]; do
                        sleep 1
                        elapsed=$((elapsed + 1))
                    done
                    if worker_group_alive "$pgid"; then
                        signal_worker_group KILL "$pgid"
                        sleep 1
                    fi
                    worker_group_alive "$pgid" \
                        && die "reason=worker_group_could_not_stop pgid=$pgid"
                fi
            fi
        fi
        if [ ! -s "$ROOT/archive.receipt" ]; then
            if [ "${PF_ACTS_CONTROL_DIRECT:-}" = 1 ]; then
                PF_ACTS_ROOT="$ROOT" PF_ACTS_BUNDLE="$BUNDLE" \
                    PF_ACTS_DMESG_FIXTURE="${PF_ACTS_DMESG_FIXTURE:-}" \
                    "$ROOT/a-cts-dut" finalize-partial host_collect
            else
                sudo -n -u gamer env -i \
                    HOME=/home/gamer USER=gamer LOGNAME=gamer PATH=/usr/local/bin:/usr/bin:/bin \
                    XDG_RUNTIME_DIR=/run/user/1000 EGL_PLATFORM=surfaceless \
                    PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1 \
                    PF_ACTS_ROOT="$ROOT" PF_ACTS_BUNDLE="$BUNDLE" \
                    "$ROOT/a-cts-dut" finalize-partial host_collect
            fi
        fi
        host_dmesg=$control_root/worker-dmesg.full
        if [ -n "${PF_ACTS_DMESG_FIXTURE:-}" ]; then
            cp "$PF_ACTS_DMESG_FIXTURE" "$host_dmesg"
        else
            # The debug caller owns this collection file.
            # shellcheck disable=SC2024
            sudo -n /usr/bin/dmesg --color=never >"$host_dmesg"
        fi
        if [ "${PF_ACTS_CONTROL_DIRECT:-}" = 1 ]; then
            cp "$host_dmesg" "$ROOT/dmesg.full"
            PF_ACTS_ROOT="$ROOT" PF_ACTS_BUNDLE="$BUNDLE" "$ROOT/a-cts-dut" reseal
        else
            sudo -n /usr/bin/install -m 0644 -o gamer -g gamer "$host_dmesg" "$ROOT/dmesg.full"
            sudo -n -u gamer env -i \
                HOME=/home/gamer USER=gamer LOGNAME=gamer PATH=/usr/local/bin:/usr/bin:/bin \
                XDG_RUNTIME_DIR=/run/user/1000 EGL_PLATFORM=surfaceless \
                PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1 \
                PF_ACTS_ROOT="$ROOT" PF_ACTS_BUNDLE="$BUNDLE" \
                "$ROOT/a-cts-dut" reseal
        fi
        [ -s "$ROOT/archive.receipt" ] || die 'reason=finalize_archive_missing'
        printf 'A_CTS_WORKER_FINALIZE state=ready %s waited=%s terminated=%s\n' \
            "$(cat "$ROOT/run-outcome.txt")" "$waited" "$terminated"
        ;;
    worker-poll)
        ROOT=$ROOT/worker-run
        [ -r "$ROOT/state" ] || die 'reason=state_missing'
        state=$(cat "$ROOT/state")
        [ -r "$ROOT/worker.pid" ] || worker_failure worker_pid_missing
        [ -r "$ROOT/worker.pgid" ] || worker_failure worker_pgid_missing
        pid=$(cat "$ROOT/worker.pid")
        pgid=$(cat "$ROOT/worker.pgid")
        [ "$pgid" = "$pid" ] || worker_failure worker_process_group_invalid
        if [ -r "$ROOT/recovery-sanity/baseline.summary" ]; then
            cat "$ROOT/recovery-sanity/baseline.summary"
        fi
        if worker_group_alive "$pgid"; then
            worker_state=${state#state=}; worker_state=${worker_state%% *}
            state_fields=${state#* }
            [ "$state_fields" != "$state" ] || state_fields=
            printf 'A_CTS_PROGRESS state=running worker=alive worker_state=%s%s%s\n' \
                "$worker_state" "${state_fields:+ }" "$state_fields"
        else
            [ -r "$ROOT/worker.exit" ] || worker_failure worker_exit_missing
            case "$state" in
                state=complete*|state=partial*) ;;
                *) worker_failure terminal_state_not_published ;;
            esac
            [ -r "$ROOT/archive.receipt" ] || worker_failure terminal_archive_missing
            printf 'A_CTS_PROGRESS %s worker=exited %s\n' "$state" "$(cat "$ROOT/worker.exit")"
        fi
        ;;
    archive-receipt)
        ROOT=$ROOT/worker-run
        if ! { [ -r "$ROOT/archive.receipt" ] && [ -r "$ROOT/final.txt" ]; }; then
            die 'reason=archive_not_ready'
        fi
        cat "$ROOT/archive.receipt"; cat "$ROOT/final.txt"
        ;;
    archive-chunk)
        case "$arg" in ''|*[!0-9]*) die 'reason=chunk_index' ;; esac
        control_root=$ROOT
        [ ! -r "$ROOT/worker-run/results.tar.gz" ] || ROOT=$ROOT/worker-run
        chunk=$control_root/archive-chunk.tmp
        dd if="$ROOT/results.tar.gz" of="$chunk" bs=36000 skip="$arg" count=1 status=none
        printf 'sha256=%s bytes=%s\n' "$(sha256sum "$chunk" | cut -d' ' -f1)" "$(wc -c <"$chunk")"
        base64 -w0 "$chunk"
        printf '\n'
        find "$chunk" -maxdepth 0 -type f -delete
        ;;
    cleanup)
        control_root=$ROOT
        ROOT=$ROOT/worker-run
        if [ -r "$ROOT/worker.pid" ] || [ -r "$ROOT/worker.pgid" ]; then
            if ! { [ -r "$ROOT/worker.pid" ] && [ -r "$ROOT/worker.pgid" ]; }; then
                die 'reason=worker_identity_incomplete'
            fi
            pid=$(cat "$ROOT/worker.pid")
            pgid=$(cat "$ROOT/worker.pgid")
            [ "$pgid" = "$pid" ] || die "reason=worker_process_group pid=$pid pgid=$pgid"
            if worker_group_alive "$pgid"; then
                signal_worker_group TERM "$pgid"
                for _ in 1 2 3 4 5; do worker_group_alive "$pgid" || break; sleep 1; done
                if worker_group_alive "$pgid"; then
                    signal_worker_group KILL "$pgid"
                    sleep 1
                fi
                worker_group_alive "$pgid" \
                    && die "reason=worker_group_could_not_stop pgid=$pgid"
            fi
        fi
        sudo -n find "$control_root" -mindepth 1 -delete
        printf 'A_CTS_CLEANUP state=complete\n'
        ;;
    *) die 'reason=unknown_mode' ;;
esac
end
