# PocketForge A133 image reproducibility allowlist
#
# Ranges are absolute zero-based byte offsets in [start,end) form.  Only bytes
# generated as per-unit identity may appear here.  In particular, the GPT
# partition TYPE-GUID at the start of each entry is content and is not masked.
# The partition-entry-array CRCs must be masked because the allowed unique GUIDs
# participate in those checksums.

REPRO_DEVICE=a133
REPRO_IMAGE_SIZE=1195397120
REPRO_EXPECTED_MASKED_SHA256=5ed90ca924f258de9b96aa2e2e32b5c05360efe9ed6356a463eccffc65a16e41

