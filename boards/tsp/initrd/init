#!/bin/busybox sh
# =============================================================================
# PocketForge initrd /init  (TrimUI Smart Pro, Allwinner A133, vendor 4.9.191)
# -----------------------------------------------------------------------------
# Boot-critical. A wrong /init = no boot. Three things must be exactly right:
#   1. module load order: videobuf2-dma-contig -> pvrsrvkm -> dc_sunxi
#   2. rootfs found by GPT PARTLABEL (vendor U-Boot/kernel resolves by NAME,
#      never a hardcoded mmcblk index)
#   3. switch_root into the real rootfs (or, in M1.B mode, fall through to a
#      busybox shell instead)
#
# Observability (USER decision 2026-06-12; bd memory tsp-debug-observability-
# no-uart): every step is logged to BOTH the serial console AND a persistent
# file on the FAT "boot-resource" partition, so a failed boot is diagnosable
# by pulling the SD even when no UART is attached. Logging never blocks boot:
# if the log partition can't be mounted, we continue console-only.
#
# Mode select is data-driven, NOT a code fork: presence of the staged marker
# file /etc/pocketforge-m1b-mode (baked into M1.B-mode initrds only) switches
# the final handoff from switch_root to an interactive shell. Same /init
# source ships in M1.B and M1.C; M1.C simply omits the marker. (bd tsp-iuz.1.11)
#
# IMPORTANT module-name nuance: the videobuf2 DMA module's FILE is hyphenated
# on disk (videobuf2-dma-contig.ko) while its runtime/lsmod name is underscored
# (videobuf2_dma_contig). insmod-by-path uses the hyphen. (verified on blobs)
# =============================================================================

# Populate busybox applets into /bin (findfs, mount, insmod, switch_root, ...).
/bin/busybox --install -s /bin

# --- pseudo-filesystems -------------------------------------------------------
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev

# BEGIN POCKETFORGE VOLATILE ROOT FUNCTIONS
# This block is executed directly by tests/test-initrd-volatile-root.sh. Keep it
# POSIX/BusyBox-ash compatible and free of boot-time side effects at definition.
PF_ROOT_MODE=normal
PF_ROOT_SELECTOR_MALFORMED=0
PF_VOLATILE_ERROR=""

pf_select_root_mode() {
    pf_sr_cmdline="$1"
    pf_sr_count=0
    pf_sr_value=""
    pf_sr_words=""
    if [ -r "$pf_sr_cmdline" ]; then
        pf_sr_words="$(cat "$pf_sr_cmdline" 2>/dev/null)"
    fi
    # Kernel command lines are whitespace-delimited, not pathname patterns.
    # Disable glob expansion so a token can never be rewritten from initrd files.
    case "$-" in
        *f*) pf_sr_restore_glob=0 ;;
        *) set -f; pf_sr_restore_glob=1 ;;
    esac
    for pf_sr_word in $pf_sr_words; do
        case "$pf_sr_word" in
            pocketforge.root)
                pf_sr_count=$((pf_sr_count + 1))
                pf_sr_value=""
                ;;
            pocketforge.root=*)
                pf_sr_count=$((pf_sr_count + 1))
                pf_sr_value="${pf_sr_word#pocketforge.root=}"
                ;;
        esac
    done
    [ "$pf_sr_restore_glob" -eq 0 ] || set +f
    PF_ROOT_MODE=normal
    PF_ROOT_SELECTOR_MALFORMED=0
    if [ "$pf_sr_count" -eq 1 ] && [ "$pf_sr_value" = volatile ]; then
        PF_ROOT_MODE=volatile
    elif [ "$pf_sr_count" -ne 0 ]; then
        PF_ROOT_SELECTOR_MALFORMED=1
    fi
}

pf_mountinfo_exact() {
    pf_mi_path="$1"
    awk -v path="$pf_mi_path" '
        $5 == path {
            for (i = 7; i <= NF; i++) {
                if ($i == "-") {
                    print $1, $6, $(i + 1), $(i + 2)
                    found = 1
                    exit
                }
            }
        }
        END { if (!found) exit 1 }
    ' "${PF_VOLATILE_MOUNTINFO:-/proc/self/mountinfo}"
}

pf_mountinfo_covering() {
    pf_mi_path="$1"
    awk -v path="$pf_mi_path" '
        function covers(mountpoint) {
            return path == mountpoint || mountpoint == "/" || \
                index(path, mountpoint "/") == 1
        }
        covers($5) && length($5) > best_length {
            for (i = 7; i <= NF; i++) {
                if ($i == "-") {
                    best_length = length($5)
                    best_id = $1
                    best_type = $(i + 1)
                    break
                }
            }
        }
        END {
            if (!best_length) exit 1
            print best_id, best_type
        }
    ' "${PF_VOLATILE_MOUNTINFO:-/proc/self/mountinfo}"
}

pf_verify_volatile_root() {
    pf_vr_rootdev="$1"
    pf_vr_newroot="$2"
    pf_vr_boot_id="$3"
    pf_vr_prefix="$pf_vr_newroot/run/pf-kit-session/$pf_vr_boot_id"

    pf_vr_line="$(pf_mountinfo_exact "$pf_vr_newroot")" || return 1
    # shellcheck disable=SC2086  # controlled, space-delimited mountinfo fields
    set -- $pf_vr_line
    [ "$3" = overlay ] || return 1

    pf_vr_line="$(pf_mountinfo_exact "$pf_vr_prefix/lower")" || return 1
    # shellcheck disable=SC2086  # controlled, space-delimited mountinfo fields
    set -- $pf_vr_line
    pf_vr_lower_options="$2"
    pf_vr_lower_type="$3"
    pf_vr_lower_source="$4"
    [ "$pf_vr_lower_type" = ext4 ] || return 1
    [ "$pf_vr_lower_source" = "$pf_vr_rootdev" ] || return 1
    case ",$pf_vr_lower_options," in
        *,ro,*) ;;
        *) return 1 ;;
    esac

    pf_vr_upper="$(pf_mountinfo_covering "$pf_vr_prefix/upper")" || return 1
    pf_vr_work="$(pf_mountinfo_covering "$pf_vr_prefix/work")" || return 1
    # shellcheck disable=SC2086  # controlled "mount-id fstype" output
    set -- $pf_vr_upper
    pf_vr_upper_id="$1"
    pf_vr_upper_type="$2"
    # shellcheck disable=SC2086  # controlled "mount-id fstype" output
    set -- $pf_vr_work
    pf_vr_work_id="$1"
    pf_vr_work_type="$2"
    case "$pf_vr_upper_id" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pf_vr_upper_id" -gt 0 ] || return 1
    [ "$pf_vr_upper_type" = tmpfs ] || return 1
    [ "$pf_vr_work_type" = tmpfs ] || return 1
    [ "$pf_vr_work_id" = "$pf_vr_upper_id" ] || return 1
    [ "$(blockdev --getro "$pf_vr_rootdev" 2>/dev/null)" = 1 ] || return 1
}

pf_mount_volatile_root() {
    pf_vr_rootdev="$1"
    pf_vr_newroot="$2"
    pf_vr_run="${PF_VOLATILE_RUN_ROOT:-/run}"
    pf_vr_lower="${PF_VOLATILE_LOWER_ROOT:-/lower}"
    pf_vr_boot_id_file="${PF_VOLATILE_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
    PF_VOLATILE_ERROR=""

    IFS= read -r pf_vr_boot_id < "$pf_vr_boot_id_file" || {
        PF_VOLATILE_ERROR=boot-id-read
        return 1
    }
    printf '%s\n' "$pf_vr_boot_id" | grep -Eq \
        '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || {
        PF_VOLATILE_ERROR=boot-id-invalid
        return 1
    }
    pf_vr_prefix="$pf_vr_run/pf-kit-session/$pf_vr_boot_id"

    mkdir -p "$pf_vr_newroot" "$pf_vr_lower" "$pf_vr_prefix/upper" \
        "$pf_vr_prefix/work" "$pf_vr_prefix/lower" || {
        PF_VOLATILE_ERROR=mountpoint-create
        return 1
    }
    blockdev --setro "$pf_vr_rootdev" || {
        PF_VOLATILE_ERROR=lower-setro
        return 1
    }
    [ "$(blockdev --getro "$pf_vr_rootdev" 2>/dev/null)" = 1 ] || {
        PF_VOLATILE_ERROR=lower-not-read-only
        return 1
    }
    mount -t ext4 -o ro,noload,noatime "$pf_vr_rootdev" "$pf_vr_lower" || {
        PF_VOLATILE_ERROR=lower-mount
        return 1
    }
    mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$pf_vr_run" || {
        PF_VOLATILE_ERROR=tmpfs-mount
        return 1
    }
    # Mounting tmpfs hides the directories made above; create them on the fresh
    # tmpfs, then use those exact directories as the overlay upper/work pair.
    pf_vr_prefix="$pf_vr_run/pf-kit-session/$pf_vr_boot_id"
    mkdir -p "$pf_vr_prefix/upper" "$pf_vr_prefix/work" "$pf_vr_prefix/lower" || {
        PF_VOLATILE_ERROR=tmpfs-directory-create
        return 1
    }
    mount -t overlay overlay \
        -o "lowerdir=$pf_vr_lower,upperdir=$pf_vr_prefix/upper,workdir=$pf_vr_prefix/work" \
        "$pf_vr_newroot" || {
        PF_VOLATILE_ERROR=overlay-mount
        return 1
    }
    [ -d "$pf_vr_newroot/run" ] || {
        PF_VOLATILE_ERROR=root-run-missing
        return 1
    }
    mount -o move "$pf_vr_run" "$pf_vr_newroot/run" || {
        PF_VOLATILE_ERROR=tmpfs-move
        return 1
    }
    pf_vr_prefix="$pf_vr_newroot/run/pf-kit-session/$pf_vr_boot_id"
    mount -o move "$pf_vr_lower" "$pf_vr_prefix/lower" || {
        PF_VOLATILE_ERROR=lower-move
        return 1
    }
    pf_verify_volatile_root "$pf_vr_rootdev" "$pf_vr_newroot" "$pf_vr_boot_id" || {
        PF_VOLATILE_ERROR=topology-check
        return 1
    }
}
# END POCKETFORGE VOLATILE ROOT FUNCTIONS

# Selection precedes every persistent-media mount. The only accepted value is
# explicit and transient; absence retains the shipped persistent-root path.
pf_select_root_mode /proc/cmdline

# --- on-SD boot log -----------------------------------------------------------
# Try to mount the FAT "boot-resource" partition rw at /pflog. The literal
# "boot" partition holds a raw Android boot.img (not a filesystem) — the FAT
# boot-resource partition is the writable, mountable log target.
#
# RESOLUTION BY FILESYSTEM LABEL, NOT GPT PARTLABEL: the Debian busybox
# `findfs` supports ONLY `LABEL=`/`UUID=` (no `PARTLABEL=`/`PARTUUID=`), and the
# `blkid` applet is not compiled in (verified against busybox-static 1.35.0).
# So the initrd resolves partitions by their FILESYSTEM volume label:
#   boot-resource FAT  -> volume label POCKETFORGE        (genimage: mkfs.vfat -n)
#   userdata      ext4 -> volume label POCKETFORGE_DATA   (genimage: ext4 label=)
# The KERNEL cmdline still uses `root=PARTLABEL=userdata` — the kernel's own
# partition parser DOES support PARTLABEL; only busybox doesn't. (The two keys
# must be kept consistent by the genimage config in tsp-iuz.1.7.)
PFLOG=""
mkdir -p /pflog
LOGDEV=""
if [ "$PF_ROOT_MODE" != volatile ]; then
    LOGDEV="$(findfs LABEL=POCKETFORGE 2>/dev/null)"
    if [ -n "$LOGDEV" ] && mount -t vfat -o rw,flush "$LOGDEV" /pflog 2>/dev/null; then
        PFLOG=/pflog/bootlog.txt
        # Truncate at boot so the log reflects THIS boot, not an accreting history.
        : > "$PFLOG" 2>/dev/null || PFLOG=""
    fi
fi

# log <msg>: emit to console always; append to the SD log when available; sync
# after every line so even a truncated log names the last reached checkpoint
# (a hard hang before the next sync loses at most one step).
log() {
    echo "[pf-initrd] $*"
    if [ -n "$PFLOG" ]; then
        echo "[pf-initrd] $*" >> "$PFLOG" 2>/dev/null
        sync 2>/dev/null
    fi
}
if [ "$PF_ROOT_SELECTOR_MALFORMED" -eq 1 ]; then
    log "STAGE: malformed pocketforge.root selector; using normal root"
fi

# The kernel auto-arms the hardware watchdog before /init. Keep it armed across
# every read-only self-flash decision; only the committed flash path may magic-
# close it. A blocked pre-flash I/O then stops receiving pings and is recovered
# by the watchdog instead of hanging the board forever.
WATCHDOG_DEV="${WATCHDOG_DEV:-/dev/watchdog}"
watchdog_present() {
    [ -c "$WATCHDOG_DEV" ]
}

watchdog_ping() {
    if watchdog_present; then
        printf '\0' > "$WATCHDOG_DEV"
    fi
}

watchdog_disarm_for_selfflash() {
    if watchdog_present; then
        printf 'V' > "$WATCHDOG_DEV"
        log "STAGE: self-flash recovery — watchdog disabled immediately before first SD write"
    fi
}

# Run one LABEL lookup for exactly one second. A normally absent label therefore
# consumes one bounded enumeration tick. If findfs wedges in interruptible I/O,
# kill/reap it; if kernel I/O is uninterruptible, wait also wedges and the still-
# armed watchdog resets the board because no further ping can occur.
sf_findfs_bounded() {
    sff_dir="${SF_FIND_TMP:-/}"
    sff_out="${sff_dir%/}/sf-findfs.$$"
    : > "$sff_out"
    findfs "$1" > "$sff_out" 2>/dev/null &
    sff_pid=$!
    sleep 1
    if kill -0 "$sff_pid" 2>/dev/null; then
        kill -9 "$sff_pid" 2>/dev/null || true
    fi
    wait "$sff_pid" 2>/dev/null || true
    cat "$sff_out"
    rm -f "$sff_out"
}

sf_wait_for_root() {
    SF_ROOTPART=""
    SF_WAIT=0
    while [ "$SF_WAIT" -lt 20 ]; do
        SF_ROOTPART="$(sf_findfs_bounded LABEL=POCKETFORGE_DATA)"
        SF_WAIT=$((SF_WAIT + 1))
        watchdog_ping
        [ -n "$SF_ROOTPART" ] && [ -b "$SF_ROOTPART" ] && return 0
        SF_ROOTPART=""
    done
    log "STAGE: self-flash gate — SD not found after 20s — normal boot"
    return 1
}

# fail <msg>: log, then drop to an interactive busybox shell on the console so a
# failed boot is debuggable rather than a silent hang. sync first so the SD log
# captures the failure reason. The cmdline carries console=ttyS0,115200.
fail() {
    log "FAILURE: $*"
    log "dropping to busybox shell (console=ttyS0,115200)"
    sync 2>/dev/null
    exec /bin/sh
}

PF_INITRD_VERSION="$(cat /etc/pocketforge-initrd-version 2>/dev/null || echo dev)"
log "STAGE: banner — PocketForge initrd ${PF_INITRD_VERSION} booting"
if [ -n "$PFLOG" ]; then
    log "STAGE: on-SD log active at boot-resource:/bootlog.txt ($LOGDEV)"
else
    log "STAGE: on-SD log UNAVAILABLE (boot-resource not mountable) — console only"
fi

# =============================================================================
# FIRST LIGHT: boot frame 000  (bd tsp-3rd3.7; fail-open, never a boot decision)
# -----------------------------------------------------------------------------
# On the open 7.x kernel the DSI panel is enabled (fbcon on DRM fbdev) before
# /init starts, seconds before systemd's animator can run, so the first lit
# picture would be a black console. A background subshell waits at most 2.5 s
# (50 x 50 ms) for /dev/fb0, then execs the static boot animator in --first-frame
# mode: it resolves the panel orientation itself (and paints nothing if it is
# unknown), unbinds fbcon, paints frame 000, logs the kmsg marker, turns the
# backlight on, and exits.
#
# Backlight (bd tsp-3rd3.14): the panel driver keeps the backlight dark at that
# first enable (kernel-sunxi-7.x otm1289a backlight_hold_ms) until the helper
# writes 0 to bl_power after painting. If the helper never does (absent, killed
# here, hung, crashed, nothing painted), the kernel's own fallback turns the
# backlight on at the end of the hold. So /init never touches the backlight.
#
# Fail-open contract:
#   - /init never waits for it and never branches on its exit status;
#   - the wait is `read -t` on a private FIFO (a shell builtin, unlike the
#     forking `sleep` applet), so the subshell has no children and one SIGKILL
#     ends everything it started;
#   - pf_first_frame_reap kills and reaps it before self-flash recovery and before
#     switch_root, polling /proc for at most ~30 ms and never blocking in `wait`
#     on a live process; a helper stuck in uninterruptible kernel I/O is logged
#     and left behind rather than holding boot;
#   - the payload is staged only into initrds built for a DRM-fbdev display
#     (build-initrd.sh --display-pipeline/--kernel-config); absent => no-op.
#     M1.B mode never starts it.
# PF_FF_DIR/PF_FF_FB/PF_FF_TICK/PF_FF_PROC are test seams (tests/test-initrd-
# first-frame.sh), like WATCHDOG_DEV above.
PF_FF_DIR="${PF_FF_DIR:-/lib/pocketforge-first-frame}"
PF_FF_FB="${PF_FF_FB:-/dev/fb0}"
PF_FF_TICK="${PF_FF_TICK:-/pf-first-frame.tick}"
PF_FF_PROC="${PF_FF_PROC:-/proc}"
PF_FF_PID=""

pf_first_frame_start() {
    PF_FF_PID=""
    if [ -f /etc/pocketforge-m1b-mode ]; then
        return 0
    fi
    # Not staged (every initrd not built for a DRM-fbdev display): silent no-op,
    # so those boots log exactly what they logged before.
    if [ ! -x "$PF_FF_DIR/pocketforge-boot-animator" ] || [ ! -f "$PF_FF_DIR/frame-000.png" ]; then
        return 0
    fi
    if ! mkfifo "$PF_FF_TICK" 2>/dev/null; then
        log "STAGE: first-frame helper skipped (cannot create $PF_FF_TICK)"
        return 0
    fi
    (
        # O_RDWR: the open never blocks and nothing ever writes, so each
        # `read -t` is a 50 ms builtin sleep.
        exec 3<>"$PF_FF_TICK"
        pf_ff_n=0
        while [ ! -e "$PF_FF_FB" ]; do
            [ "$pf_ff_n" -lt 50 ] || exit 124
            # shellcheck disable=SC2034,SC3045  # busybox ash: fractional read -t
            read -r -t 0.05 pf_ff_x <&3
            pf_ff_n=$((pf_ff_n + 1))
        done
        exec 3<&- 0</dev/null 1>/dev/null
        exec "$PF_FF_DIR/pocketforge-boot-animator" --first-frame --frames-dir "$PF_FF_DIR"
    ) &
    PF_FF_PID=$!
    log "STAGE: first-frame helper pid $PF_FF_PID (waits <= 2.5 s for $PF_FF_FB; fail-open)"
}

pf_first_frame_reap() {
    [ -n "$PF_FF_PID" ] || return 0
    pf_ff_pid="$PF_FF_PID"
    PF_FF_PID=""
    kill -KILL "$pf_ff_pid" 2>/dev/null
    if [ ! -r "$PF_FF_PROC/$$/stat" ]; then
        # Without a readable /proc a live process and a reaped one look alike,
        # and `wait` on a live one could block the boot: do not wait at all.
        log "WARN: first-frame helper pid $pf_ff_pid signalled; $PF_FF_PROC unreadable — not waiting; boot continues"
        return 0
    fi
    pf_ff_i=0
    while :; do
        pf_ff_st=""
        { read -r pf_ff_st < "$PF_FF_PROC/$pf_ff_pid/stat"; } 2>/dev/null
        pf_ff_st="${pf_ff_st##*) }"
        pf_ff_st="${pf_ff_st%% *}"
        case "$pf_ff_st" in
            ''|Z|X)
                # Exited (zombie or already collected): this wait cannot block.
                wait "$pf_ff_pid" 2>/dev/null
                pf_ff_rc=$?
                log "STAGE: first-frame helper reaped (rc=$pf_ff_rc)"
                return 0
                ;;
        esac
        [ "$pf_ff_i" -lt 6 ] || break
        # 5 ms builtin sleep on the tick FIFO (no fork on the handoff path).
        # shellcheck disable=SC2034,SC3045
        read -r -t 0.005 pf_ff_x <>"$PF_FF_TICK"
        pf_ff_i=$((pf_ff_i + 1))
    done
    log "WARN: first-frame helper pid $pf_ff_pid still in state $pf_ff_st after SIGKILL — not waiting; boot continues"
    return 0
}

pf_first_frame_start

# =============================================================================
# SELF-FLASH RECOVERY  (dev images only; bd tsp-bcx.17)
# -----------------------------------------------------------------------------
# In-place whole-image self-flash for swap-free dev iteration. A host pushes a
# compressed image (.img.xz) to a RAW staging region in the UNALLOCATED TAIL of
# the SD (past the image; a normal flash never writes there), then writes a
# 512-byte flag record to a trailing sector and reboots. This branch — running
# entirely from the RAM initramfs with the SD UNMOUNTED — reads the staged blob
# from the high region and writes the decompressed whole image to the low region
# [0,img) of the SAME unmounted SD (non-overlapping), SHA-verifies, then reboots
# onto the new image. NO network, NO RAM staging, NOTHING from the SD mounted
# during the dd.
#
# Power-safe: the flag stays state=armed until a VERIFIED flash completes, so a
# power-loss mid-flash simply retries on the next boot (the destructive dd is
# idempotent). A `tries` cap stops a bootloop on a persistently bad blob.
#
# No hard-coded offsets: stage_lba / sizes / SHAs are computed by the host pusher
# (self-flash-device.sh) and read from the flag — /init only reads + validates +
# acts. Gated on /etc/pocketforge-selfflash (staged into DEV initrds only) so a
# prod image never honors a stray flag.  NOTE: if prod ever gains rootfs
# auto-expand, it MUST preserve this trailing state region (not implemented here).
#
# busybox/initramfs portability: explicit byte block sizes (no 4M suffix), no
# conv=fsync (uncertain in busybox dd) — durability via explicit `sync`.
# =============================================================================
SF_BS=4194304          # 4 MiB transfer block

# The v3 engine is dev-initrd-only and has no definition-time side effects.
# Its separate marker is checked again before any tail record is read.
if [ -f /lib/pocketforge-self-flash-v3.sh ]; then
    SF_V3_WORK=/run/pocketforge-self-flash-v3
    mkdir -p "$SF_V3_WORK" \
        || fail "self-flash v3 work directory initialization failed"
    export SF_V3_WORK
    . /lib/pocketforge-self-flash-v3.sh
fi

# BEGIN POCKETFORGE SELF-FLASH V2 FUNCTIONS
# This block is executed directly by tests/test-initrd-selfflash-v2.sh. Keep it
# POSIX/BusyBox-ash compatible and free of boot-time side effects at definition.
#
# DT identity, not Linux enumeration identity: boards/tsp/trimui-smart-pro.dts
# defines the removable SD host as sdmmc@04020000 (reg 0x04020000, alias mmc0)
# and the non-removable eMMC host as sdmmc@04022000.  A block name such as
# mmcblk0 is never evidence that a device is the SD card.
SF_SD_CONTROLLER=04020000
SF_SYS_CLASS_BLOCK="${SF_SYS_CLASS_BLOCK:-/sys/class/block}"
SF_DEV_ROOT="${SF_DEV_ROOT:-/dev}"
SF_RAM_ROOT="${SF_RAM_ROOT:-}"
SF_UPTIME_FILE="${SF_UPTIME_FILE:-/proc/uptime}"
SF_MOUNTINFO_FILE="${SF_MOUNTINFO_FILE:-/proc/self/mountinfo}"
SF_BS="${SF_BS:-4194304}"

sf_v2_get() {
    printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -1
}

sf_v2_sha() {
    [ "${#1}" -eq 64 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1;; esac
}

sf_v2_uint() {
    case "$1" in ''|*[!0-9]*) return 1;; esac
    [ "$1" -gt 0 ] 2>/dev/null
}

sf_v2_controller_path() {
    case "$1" in
        *'/4020000.mmc/'*|*'/04020000.mmc/'*|*'/sdmmc@04020000/'*) return 0 ;;
        *) return 1 ;;
    esac
}

sf_v2_validate_and_resolve() {
    sf_v2_flag="$1"
    SF_FLAG_MAGIC="$(sf_v2_get "$sf_v2_flag" PF_FLAG)"
    SF_VERSION="$(sf_v2_get "$sf_v2_flag" ver)"
    SF_STATE="$(sf_v2_get "$sf_v2_flag" state)"
    SF_GENERATION="$(sf_v2_get "$sf_v2_flag" generation)"
    SF_DESCRIPTOR_SHA="$(sf_v2_get "$sf_v2_flag" descriptor_sha256)"
    SF_XZ_FILE="$(sf_v2_get "$sf_v2_flag" xz_file)"
    SF_XZ_BYTES="$(sf_v2_get "$sf_v2_flag" xz_bytes)"
    SF_XZ_SHA="$(sf_v2_get "$sf_v2_flag" xz_sha256)"
    SF_IMG_BYTES="$(sf_v2_get "$sf_v2_flag" img_bytes)"
    SF_IMG_SHA="$(sf_v2_get "$sf_v2_flag" img_sha256)"
    SF_FLAG_CONTROLLER="$(sf_v2_get "$sf_v2_flag" sd_controller)"
    SF_EXPECTED_SERIAL="$(sf_v2_get "$sf_v2_flag" sd_serial)"
    SF_EXPECTED_SECTORS="$(sf_v2_get "$sf_v2_flag" card_sectors)"
    SF_SEED_DIR="$(sf_v2_get "$sf_v2_flag" seed_dir)"
    SF_SEED_META_SHA="$(sf_v2_get "$sf_v2_flag" seed_meta_sha256)"
    SF_SEED_NETWORK_SHA="$(sf_v2_get "$sf_v2_flag" seed_network_sha256)"
    SF_SEED_USER_SHA="$(sf_v2_get "$sf_v2_flag" seed_user_sha256)"
    SF_TRIES="$(sf_v2_get "$sf_v2_flag" tries)"

    [ "$SF_FLAG_MAGIC" = 1 ] && [ "$SF_VERSION" = 2 ] \
        && [ "$SF_STATE" = armed ] || return 1
    [ "${#SF_GENERATION}" -eq 32 ] || return 1
    case "$SF_GENERATION" in *[!0-9a-f]*) return 1;; esac
    sf_v2_sha "$SF_DESCRIPTOR_SHA" && sf_v2_sha "$SF_XZ_SHA" \
        && sf_v2_sha "$SF_IMG_SHA" && sf_v2_sha "$SF_SEED_META_SHA" \
        && sf_v2_sha "$SF_SEED_NETWORK_SHA" && sf_v2_sha "$SF_SEED_USER_SHA" \
        || return 1
    sf_v2_uint "$SF_XZ_BYTES" && sf_v2_uint "$SF_IMG_BYTES" \
        && sf_v2_uint "$SF_EXPECTED_SECTORS" || return 1
    case "$SF_TRIES" in ''|*[!0-9]*) return 1;; esac
    [ "$SF_FLAG_CONTROLLER" = "$SF_SD_CONTROLLER" ] || return 1
    [ "$SF_XZ_FILE" = /var/tmp/pf-selfflash-stage.img.xz ] || return 1
    [ "$SF_SEED_DIR" = /var/tmp/pf-selfflash-seed ] || return 1
    [ "${#SF_EXPECTED_SERIAL}" -eq 10 ] || return 1
    case "$SF_EXPECTED_SERIAL" in 0x*) ;; *) return 1;; esac
    sf_v2_serial_hex="${SF_EXPECTED_SERIAL#0x}"
    case "$sf_v2_serial_hex" in *[!0-9a-fA-F]*) return 1;; esac
    [ "$SF_IMG_BYTES" -le $((SF_EXPECTED_SECTORS * 512)) ] || return 1

    sf_v2_count=0
    SF_SD=""
    SF_SD_SYS=""
    SF_CARD_TYPE=""
    for sf_v2_entry in "$SF_SYS_CLASS_BLOCK"/*; do
        [ -e "$sf_v2_entry" ] || continue
        [ -e "$sf_v2_entry/device" ] || continue
        sf_v2_physical="$(readlink -f "$sf_v2_entry/device" 2>/dev/null)"
        sf_v2_controller_path "$sf_v2_physical" || continue
        # MMC gendisks intentionally never set GENHD_FL_REMOVABLE, including
        # hot-pluggable SD media (kernel drivers/mmc/core/block.c:2556-2566).
        # The parent MMC card object supplies the authoritative SD/MMC type.
        sf_v2_type="$(cat "$sf_v2_entry/device/type" 2>/dev/null)"
        [ "$sf_v2_type" = SD ] || continue
        sf_v2_serial="$(cat "$sf_v2_entry/device/serial" 2>/dev/null)"
        sf_v2_sectors="$(cat "$sf_v2_entry/size" 2>/dev/null)"
        [ "$sf_v2_serial" = "$SF_EXPECTED_SERIAL" ] || continue
        [ "$sf_v2_sectors" = "$SF_EXPECTED_SECTORS" ] || continue
        sf_v2_device="$SF_DEV_ROOT/${sf_v2_entry##*/}"
        if [ "$SF_DEV_ROOT" = /dev ]; then
            [ -b "$sf_v2_device" ] || continue
        else
            [ -f "$sf_v2_device" ] || continue
        fi
        sf_v2_count=$((sf_v2_count + 1))
        SF_SD="$sf_v2_device"
        SF_SD_SYS="$sf_v2_entry"
        SF_CARD_TYPE="$sf_v2_type"
    done
    [ "$sf_v2_count" -eq 1 ] \
        || { SF_SD=""; SF_SD_SYS=""; SF_CARD_TYPE=""; return 1; }
}

sf_v2_phase() {
    sf_v2_when="$(cut -d' ' -f1 "$SF_UPTIME_FILE" 2>/dev/null)"
    [ -n "$sf_v2_when" ] || sf_v2_when=unknown
    printf 'phase=%s uptime=%s\n' "$1" "$sf_v2_when" >>"$SF_RAM_ROOT/sf-phase.log"
}

sf_v2_stage_ram() {
    sf_v2_mnt="$1"
    SF_STAGED_XZ="$SF_RAM_ROOT/sf-staged.xz"
    SF_SEED_RAM="$SF_RAM_ROOT/sf-seed"
    rm -f "$SF_STAGED_XZ" "$SF_RAM_ROOT/sf-phase.log"
    if [ -d "$SF_SEED_RAM" ]; then
        rm -r "$SF_SEED_RAM" || return 1
    fi
    mkdir -p "$SF_SEED_RAM" || return 1
    sf_v2_phase ram_copy_start
    sf_v2_src_xz="$sf_v2_mnt$SF_XZ_FILE"
    [ -f "$sf_v2_src_xz" ] && [ ! -L "$sf_v2_src_xz" ] || return 1
    [ "$(stat -c %s "$sf_v2_src_xz" 2>/dev/null)" = "$SF_XZ_BYTES" ] || return 1
    [ "$(sha256sum "$sf_v2_src_xz" 2>/dev/null | cut -d' ' -f1)" = "$SF_XZ_SHA" ] \
        || return 1
    cp "$sf_v2_src_xz" "$SF_STAGED_XZ" || return 1
    [ "$(sha256sum "$SF_STAGED_XZ" 2>/dev/null | cut -d' ' -f1)" = "$SF_XZ_SHA" ] \
        || return 1

    sf_v2_src_seed="$sf_v2_mnt$SF_SEED_DIR"
    sf_v2_seen=""
    for sf_v2_name in meta-data network-config user-data; do
        sf_v2_src="$sf_v2_src_seed/$sf_v2_name"
        [ -f "$sf_v2_src" ] && [ ! -L "$sf_v2_src" ] || return 1
        cp "$sf_v2_src" "$SF_SEED_RAM/$sf_v2_name" || return 1
        sf_v2_seen="$sf_v2_seen $sf_v2_name"
    done
    sf_v2_count=0
    for sf_v2_item in "$sf_v2_src_seed"/*; do
        [ -e "$sf_v2_item" ] || continue
        case " $sf_v2_seen " in *" ${sf_v2_item##*/} "*) ;; *) return 1;; esac
        sf_v2_count=$((sf_v2_count + 1))
    done
    [ "$sf_v2_count" -eq 3 ] || return 1
    [ "$(sha256sum "$SF_SEED_RAM/meta-data" | cut -d' ' -f1)" = "$SF_SEED_META_SHA" ] \
        && [ "$(sha256sum "$SF_SEED_RAM/network-config" | cut -d' ' -f1)" = "$SF_SEED_NETWORK_SHA" ] \
        && [ "$(sha256sum "$SF_SEED_RAM/user-data" | cut -d' ' -f1)" = "$SF_SEED_USER_SHA" ] \
        || return 1
    sf_v2_phase ram_copy_complete
}

# Test seam: the production definition is a no-op. Hermetic tests override it
# to corrupt the fake device between write and readback.
sf_v2_after_write() { :; }

sf_v2_terminal_recovery() {
    log "selfflash: TERMINAL recovery state — $*; host FEL whole-image recovery required"
    sync 2>/dev/null
    # PID 1 becomes an initramfs shell. Exiting it ends init instead of resuming
    # the boot path, so a partially written image can never be mounted as root.
    exec /bin/sh
}

sf_v2_write_verify() {
    [ -n "$SF_SD" ] && [ -f "$SF_STAGED_XZ" ] || return 1
    sf_v2_phase write_start
    if ! unxz <"$SF_STAGED_XZ" | head -c "$SF_IMG_BYTES" \
            | dd of="$SF_SD" bs="$SF_BS" conv=notrunc 2>/dev/null; then
        return 1
    fi
    sync
    sf_v2_phase write_complete
    sf_v2_after_write
    sf_v2_phase verify_start
    sf_v2_got="$(dd if="$SF_SD" bs="$SF_BS" 2>/dev/null \
        | head -c "$SF_IMG_BYTES" | sha256sum | cut -d' ' -f1)"
    [ "$sf_v2_got" = "$SF_IMG_SHA" ] || return 1
    SF_VERIFIED_RAW_SHA="$sf_v2_got"
    sf_v2_phase verify_complete
}

sf_v2_install_seed() {
    sf_v2_fat="$1"
    [ "$SF_VERIFIED_RAW_SHA" = "$SF_IMG_SHA" ] || return 1
    [ -d "$sf_v2_fat" ] || return 1
    sf_v2_phase seed_install_start
    for sf_v2_name in meta-data network-config user-data; do
        cp "$SF_SEED_RAM/$sf_v2_name" \
            "$sf_v2_fat/.pf-seed-$SF_GENERATION-$sf_v2_name.tmp" || return 1
    done
    [ "$(sha256sum "$sf_v2_fat/.pf-seed-$SF_GENERATION-meta-data.tmp" | cut -d' ' -f1)" = "$SF_SEED_META_SHA" ] \
        && [ "$(sha256sum "$sf_v2_fat/.pf-seed-$SF_GENERATION-network-config.tmp" | cut -d' ' -f1)" = "$SF_SEED_NETWORK_SHA" ] \
        && [ "$(sha256sum "$sf_v2_fat/.pf-seed-$SF_GENERATION-user-data.tmp" | cut -d' ' -f1)" = "$SF_SEED_USER_SHA" ] \
        || return 1
    for sf_v2_name in meta-data network-config user-data; do
        mv -f "$sf_v2_fat/.pf-seed-$SF_GENERATION-$sf_v2_name.tmp" \
            "$sf_v2_fat/$sf_v2_name" || return 1
    done
    sync
    [ "$(sha256sum "$sf_v2_fat/meta-data" | cut -d' ' -f1)" = "$SF_SEED_META_SHA" ] \
        && [ "$(sha256sum "$sf_v2_fat/network-config" | cut -d' ' -f1)" = "$SF_SEED_NETWORK_SHA" ] \
        && [ "$(sha256sum "$sf_v2_fat/user-data" | cut -d' ' -f1)" = "$SF_SEED_USER_SHA" ] \
        || return 1
    sf_v2_phase seed_install_complete
    {
        printf 'Schema=pocketforge.self-flash/v2\n'
        printf 'Generation=%s\n' "$SF_GENERATION"
        printf 'DescriptorSHA256=%s\n' "$SF_DESCRIPTOR_SHA"
        printf 'Controller=%s\n' "$SF_FLAG_CONTROLLER"
        printf 'CardType=%s\n' "$SF_CARD_TYPE"
        printf 'CardSerial=%s\n' "$SF_EXPECTED_SERIAL"
        printf 'CardSectors=%s\n' "$SF_EXPECTED_SECTORS"
        printf 'WrittenRangeBytes=%s\n' "$SF_IMG_BYTES"
        printf 'RawSHA256=%s\n' "$SF_VERIFIED_RAW_SHA"
        printf 'SeedMetaSHA256=%s\n' "$SF_SEED_META_SHA"
        printf 'SeedNetworkSHA256=%s\n' "$SF_SEED_NETWORK_SHA"
        printf 'SeedUserSHA256=%s\n' "$SF_SEED_USER_SHA"
        cat "$SF_RAM_ROOT/sf-phase.log"
    } >"$sf_v2_fat/.pocketforge-selfflash-receipt.tmp" || return 1
    printf '%s\n' "$SF_VERIFIED_RAW_SHA" >"$sf_v2_fat/.pocketforge-flashed-sha.tmp" \
        || return 1
    sync
    mv -f "$sf_v2_fat/.pocketforge-selfflash-receipt.tmp" \
        "$sf_v2_fat/pocketforge-selfflash-receipt" || return 1
    mv -f "$sf_v2_fat/.pocketforge-flashed-sha.tmp" \
        "$sf_v2_fat/pocketforge-flashed-sha" || return 1
    sync
    [ "$(cat "$sf_v2_fat/pocketforge-flashed-sha" 2>/dev/null)" = "$SF_IMG_SHA" ] \
        || return 1
}

sf_v2_partition_on_selected_card() {
    sf_v2_partition="$1"
    sf_v2_partition_sys="$SF_SYS_CLASS_BLOCK/${sf_v2_partition##*/}"
    [ -e "$sf_v2_partition_sys" ] || return 1
    sf_v2_whole_real="$(readlink -f "$SF_SD_SYS" 2>/dev/null)"
    sf_v2_partition_real="$(readlink -f "$sf_v2_partition_sys" 2>/dev/null)"
    case "$sf_v2_partition_real" in "$sf_v2_whole_real"/*) return 0;; esac
    return 1
}

sf_v2_selected_card_unmounted() {
    sf_v2_whole_real="$(readlink -f "$SF_SD_SYS" 2>/dev/null)"
    [ -n "$sf_v2_whole_real" ] || return 1
    for sf_v2_dev_file in "$sf_v2_whole_real/dev" "$sf_v2_whole_real"/*/dev; do
        [ -f "$sf_v2_dev_file" ] || continue
        sf_v2_major_minor="$(cat "$sf_v2_dev_file" 2>/dev/null)"
        [ -n "$sf_v2_major_minor" ] || return 1
        if awk -v dev="$sf_v2_major_minor" '$3 == dev { found=1 } END { exit !found }' \
                "$SF_MOUNTINFO_FILE"; then
            return 1
        fi
    done
    return 0
}
# END POCKETFORGE SELF-FLASH V2 FUNCTIONS

# Cache-bypass for high-sector reads (tsp-bcx.17 Option-1). The early initramfs
# was reading sectors ABOVE the partitioned region as all-zeros while the full OS
# read them correctly — research (kernel-source-verified: capacity is full-card
# at probe, the GPT-size warning is benign) points at a bdev page-cache transient
# serving a cached zero page. Dropping the page cache before a raw read forces a
# fresh fetch from the device. Cheap and harmless if it was never the cause.
sf_drop_cache() { sync 2>/dev/null; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null; }

# BEGIN POCKETFORGE SELF-FLASH V3 GATE
# A zero arm slot is the normal no-op state. Any nonzero malformed arm, or a
# valid arm paired with a non-ready receipt, is terminal: it must never fall
# through to a normal root mount or retry a destructive transaction.
sf_v3_terminal_recovery() {
    log "selfflash-v3: TERMINAL recovery state — $*; host FEL recovery required"
    sync 2>/dev/null
    exec /bin/sh
}

if [ "$PF_ROOT_MODE" != volatile ] \
        && [ -f /lib/pocketforge-self-flash-v3.sh ]; then
    watchdog_ping
    log "STAGE: self-flash v3 gate — waiting for SD enumeration"
    if sf_wait_for_root; then
        watchdog_ping
        if sf_v3_load_armed_transaction; then
            log "selfflash-v3: admitted generation=$SF_V3_GENERATION"
            pf_first_frame_reap
            if [ -n "$PFLOG" ]; then
                sync
                if ! umount /pflog 2>/dev/null; then
                    sf_v3_terminal_recovery "boot FAT log unmount failed"
                fi
                PFLOG=""
            fi
            if ! sf_v2_selected_card_unmounted; then
                sf_v3_terminal_recovery "selected SD remains mounted"
            fi
            watchdog_disarm_for_selfflash
            if sf_v3_run_armed_transaction; then
                sync
                reboot -f
                sf_v3_terminal_recovery "target reboot returned"
            fi
            sf_v3_terminal_recovery "transaction failed"
        fi
        case "$SF_V3_LOAD_STATE" in
            absent)
                log "STAGE: self-flash v3 gate — no arm record — normal boot"
                ;;
            *)
                sf_v3_terminal_recovery "arm/receipt state refused ($SF_V3_LOAD_STATE)"
                ;;
        esac
    fi
fi
# END POCKETFORGE SELF-FLASH V3 GATE

# Perform recovery. FILE-BASED (tsp-bcx.17): the flag + staged .img.xz are FILES on
# the rootfs partition (p5), which the initramfs PROVABLY mounts every boot — so we
# never depend on the unreliable early-boot RAW high-sector read that defeated the
# raw-flag design. Copy the .xz into RAM, unmount the SD, then flash [0,img).
# args: P5_MOUNT FLAGTXT. The write target is resolved independently from the
# DT controller/card identity in the v2 flag; it is never derived from mmcblkN.
# Returns non-zero to fall through to normal boot; reboots (no return) on success.
selfflash_recover() {
    MNT="$1"; FLAGTXT="$2"
    if ! sf_v2_validate_and_resolve "$FLAGTXT"; then
        log "selfflash: v2 identity/descriptor guard refused — normal boot"
        return 1
    fi
    SD="$SF_SD"; xz_file="$SF_XZ_FILE"; xz_bytes="$SF_XZ_BYTES"
    img_bytes="$SF_IMG_BYTES"
    tries="$SF_TRIES"; SRC="$MNT$xz_file"
    log "selfflash: ARMED v2 controller=$SF_FLAG_CONTROLLER serial=$SF_EXPECTED_SERIAL sectors=$SF_EXPECTED_SECTORS xz=$xz_file ($xz_bytes B) img=$img_bytes tries=$tries"
    [ -f "$SRC" ] || { log "selfflash: staged .xz missing ($SRC) — normal boot"; return 1; }

    if [ "$tries" -ge 3 ]; then
        log "selfflash: tries=$tries >= 3 — giving up; clearing flag, normal boot"
        # This is fail-closed cleanup, not a flash attempt, so keep the watchdog
        # armed. An interrupted cleanup either leaves the flag for another safe
        # cleanup pass or removes it and makes the next boot take the no-flag path.
        watchdog_ping
        mount -o remount,rw "$MNT" 2>/dev/null
        rm -f "$MNT/var/tmp/pf-selfflash.flag" "$SRC"
        rm -r "$MNT$SF_SEED_DIR" 2>/dev/null || :
        sync
        watchdog_ping
        return 1
    fi

    # Copy the compressed image and exact per-generation NoCloud seed into RAM so
    # every SD filesystem can be unmounted before the destructive whole-image write.
    log "selfflash: copying and verifying staged v2 payloads into RAM..."
    watchdog_ping
    if ! sf_v2_stage_ram "$MNT"; then
        log "selfflash: staged v2 payload verification failed — normal boot"
        return 1
    fi
    log "selfflash: RAM image and seed verified OK"
    watchdog_ping

    # Cap crash-loops: bump tries in the on-SD flag FILE BEFORE the destructive dd.
    # This rw remount is the first persistent mutation on a validated flash path.
    watchdog_disarm_for_selfflash
    if ! mount -o remount,rw "$MNT" 2>/dev/null; then
        log "selfflash: cannot arm retry record — normal boot"
        return 1
    fi
    if ! printf '%s\n' "$FLAGTXT" | sed "s/^tries=.*/tries=$((tries+1))/" \
            > "$MNT/var/tmp/.pf-selfflash.flag.tmp" 2>/dev/null \
            || ! mv -f "$MNT/var/tmp/.pf-selfflash.flag.tmp" \
                "$MNT/var/tmp/pf-selfflash.flag" 2>/dev/null; then
        log "selfflash: retry record update failed — normal boot"
        return 1
    fi
    sync

    # release the SD — NOTHING from the SD may be mounted during the dd
    if [ -n "$PFLOG" ]; then sync; umount /pflog 2>/dev/null; PFLOG=""; fi
    if ! umount "$MNT" 2>/dev/null || ! sf_v2_selected_card_unmounted; then
        log "selfflash: selected controller/card still mounted — refusing to flash"
        fail "selfflash: SD still mounted before dd"
    fi
    log "selfflash: SD unmounted; writing and fully verifying RawBytes on controller 0x$SF_FLAG_CONTROLLER ($SD)"
    if ! sf_v2_write_verify; then
        sf_v2_terminal_recovery "whole-image write/readback verification failed"
    fi
    rm -f "$SF_STAGED_XZ"

    # Re-resolve the freshly written FAT, then prove that partition belongs to
    # the already selected physical SD before mounting it. Seed injection and
    # its readback are part of verified success, never best-effort.
    sf_drop_cache
    NEWFAT="$(findfs LABEL=POCKETFORGE 2>/dev/null)"
    if [ -z "$NEWFAT" ] || ! sf_v2_partition_on_selected_card "$NEWFAT"; then
        sf_v2_terminal_recovery "new boot FAT is absent or not on selected SD"
    fi
    mkdir -p /sf-newfat
    if ! mount -t vfat -o rw "$NEWFAT" /sf-newfat 2>/dev/null; then
        sf_v2_terminal_recovery "new boot FAT mount failed"
    fi
    if ! sf_v2_install_seed /sf-newfat; then
        umount /sf-newfat 2>/dev/null
        sf_v2_terminal_recovery "seed injection/readback failed"
    fi
    umount /sf-newfat 2>/dev/null || {
        sf_v2_terminal_recovery "new boot FAT unmount failed"
    }

    # Success: the reflash overwrote p5, so the flag file is gone -> next boot normal.
    log "selfflash: image, seed, and receipt verified OK — rebooting into the new image"
    sync
    reboot -f
    return 0   # not reached
}

# --- self-flash gate (dev images only) ----------------------------------------
# Runs BEFORE the GPU insmods so recovery still works even if a bad image's GPU
# modules would fail (fail() drops to a shell). The SD enumerates asynchronously
# a few seconds into boot (mmc0 "new SDXC card" ~t=3.9s), AFTER /init starts — so
# wait for the rootfs partition to appear before reading the flag, rather than
# racing enumeration (the original rootfs mount below only wins that race because
# the GPU insmods burn enough time first).
if [ "$PF_ROOT_MODE" != volatile ] && [ -f /etc/pocketforge-selfflash ]; then
    # Keep the watchdog armed while the gate performs bounded enumeration and the
    # single file-based flag decision. Only a validated flash path disarms it,
    # immediately before selfflash_recover's first persistent SD write.
    watchdog_ping
    log "STAGE: self-flash gate — waiting for SD enumeration"
    if sf_wait_for_root; then
        log "STAGE: self-flash gate — SD ready after ${SF_WAIT}s ($SF_ROOTPART)"
        watchdog_ping
        # FILE-BASED flag (tsp-bcx.17): mount the rootfs (p5) READ-ONLY and look for
        # the flag FILE. The initramfs provably mounts p5 every boot, so this never
        # depends on the unreliable early-boot RAW high-sector read (which missed an
        # armed flag for all 15 retries on a bad boot). selfflash_recover copies the
        # staged .xz into RAM, unmounts, and flashes [0,img).
        mkdir -p /sfp5
        watchdog_ping
        if mount -t ext4 -o ro "$SF_ROOTPART" /sfp5 2>/dev/null; then
            watchdog_ping
            if [ -f /sfp5/var/tmp/pf-selfflash.flag ]; then
                watchdog_ping
                SF_FLAGTXT="$(cat /sfp5/var/tmp/pf-selfflash.flag 2>/dev/null)"
                watchdog_ping
                log "STAGE: self-flash flag FILE present on ${SF_ROOTPART}"
                watchdog_ping
                pf_first_frame_reap   # self-flash mode runs with no helper (tsp-3rd3.7)
                selfflash_recover "/sfp5" "$SF_FLAGTXT" \
                    && log "selfflash: recovery returned without reboot — continuing normal boot" \
                    || log "selfflash: not flashing — continuing normal boot"
            else
                log "STAGE: self-flash gate — no flag file — normal boot"
            fi
            umount /sfp5 2>/dev/null || true
        else
            log "STAGE: self-flash gate — could not mount ${SF_ROOTPART} ro — normal boot"
        fi
    fi
fi

# --- PowerVR + buffer plumbing ------------------------------------------------
# Load order: vb2 (DMA buffers) -> pvrsrvkm (GPU KMD) -> dc_sunxi (DC bridge).
# Per-insmod trap: a silent skip past a vermagic mismatch would leave no
# breadcrumb, so each failure is fatal-with-a-message.
log "STAGE: insmod videobuf2-dma-contig"
insmod /lib/modules/videobuf2-dma-contig.ko || fail "insmod videobuf2-dma-contig failed (rc=$?)"

log "STAGE: insmod pvrsrvkm"
insmod /lib/modules/pvrsrvkm.ko || fail "insmod pvrsrvkm failed (rc=$?)"

log "STAGE: insmod dc_sunxi"
insmod /lib/modules/dc_sunxi.ko || fail "insmod dc_sunxi failed (rc=$?)"

log "STAGE: modules loaded"

# --- WiFi (NOT in the initrd) -------------------------------------------------
# PocketForge boots from a LOCAL SD rootfs, so WiFi is not needed before
# switch_root. The xradio triplet (xradio_mac -> xradio_core -> xradio_wlan)
# + xr829 firmware live in the rootfs and are brought up post-switch_root by
# wpa_supplicant + udhcpc (M1.C). Decision recorded in bd tsp-iuz.1.6.
#   insmod /lib/modules/xradio_mac.ko
#   insmod /lib/modules/xradio_core.ko
#   insmod /lib/modules/xradio_wlan.ko

# --- M1.B mode: fall through to a shell instead of switch_root ----------------
# Data-driven branch (NOT a separate /init). In M1.B-mode initrds the marker
# file is staged; in M1.C-onward initrds it is absent and we switch_root.
if [ -f /etc/pocketforge-m1b-mode ]; then
    log "STAGE: M1.B mode — falling through to busybox shell (no switch_root)"
    log "       (this is expected for the M1.B first-SD-boot milestone, G0)"
    # Disable the sunxi-wdt watchdog (CONFIG_SUNXI_WDOG_BOOTON=y auto-starts it
    # at driver probe with a 16-second timeout — without this, the device reboots
    # before the user can interact with the shell). Magic close: write 'V' then
    # close the fd.  Works because CONFIG_WATCHDOG_NOWAYOUT is not set (nowayout=0).
    if [ -c /dev/watchdog ]; then
        printf 'V' > /dev/watchdog
        log "STAGE: watchdog disabled (magic close)"
    else
        log "WARN: /dev/watchdog not found — watchdog may still be armed"
    fi
    sync 2>/dev/null
    exec /bin/sh
fi

# --- find + mount the rootfs by filesystem LABEL ------------------------------
# By LABEL (POCKETFORGE_DATA), not PARTLABEL — busybox findfs has no PARTLABEL
# support (see the on-SD-log block above). The kernel cmdline's
# root=PARTLABEL=userdata is the kernel's own resolution and is unaffected.
log "STAGE: locate rootfs by LABEL=POCKETFORGE_DATA"
ROOT="$(findfs LABEL=POCKETFORGE_DATA 2>/dev/null)"
[ -n "$ROOT" ] || fail "rootfs not found (LABEL=POCKETFORGE_DATA)"
log "STAGE: rootfs is $ROOT"

mkdir -p /newroot
if [ "$PF_ROOT_MODE" = volatile ]; then
    log "STAGE: mount $ROOT -> /newroot (volatile overlay)"
    pf_mount_volatile_root "$ROOT" /newroot || fail "volatile root setup failed: ${PF_VOLATILE_ERROR}"
    log "STAGE: volatile root verified (read-only lower, boot-local tmpfs upper/work)"
else
    log "STAGE: mount $ROOT -> /newroot (ext4)"
    mount -t ext4 -o rw,noatime "$ROOT" /newroot || fail "mount $ROOT failed"
fi

# --- first-frame helper: reap before handoff (bd tsp-3rd3.7) ------------------
# Nothing the initrd started may outlive it into switch_root (see FIRST LIGHT).
pf_first_frame_reap

# --- watchdog keepalive before handoff -----------------------------------------
# The vendor kernel auto-starts sunxi-wdt at driver probe (CONFIG_SUNXI_WDOG_
# BOOTON=y, 16-second timeout, nowayout=0).  By this point ~3-5s of the 16s have
# elapsed.  Reset the counter so systemd has the full 16s window to start up,
# parse /etc/systemd/system.conf.d/watchdog.conf, and open /dev/watchdog itself.
# IMPORTANT: '\0' is a keepalive ping (resets the counter).  Do NOT write 'V' —
# that is the magic-close character which DISARMS the watchdog entirely.
if [ -c /dev/watchdog ]; then
    printf '\0' > /dev/watchdog
    log "STAGE: watchdog ping (counter reset for systemd handoff)"
else
    log "WARN: /dev/watchdog not found — watchdog ping skipped"
fi

# --- hand off to the real init ------------------------------------------------
# Unmount the log partition cleanly before handoff (switch_root will move /proc,
# /sys, /dev into /newroot; /pflog lives outside that and must be released).
if [ -n "$PFLOG" ]; then
    sync 2>/dev/null
    umount /pflog 2>/dev/null
fi

# Pre-switch_root verification: execv() after chroot returns ENOENT ("No such
# file or directory") when the ELF interpreter (PT_INTERP) is missing, not just
# when the binary itself is missing — and busybox prints the same misleading
# "can't execute" message for both cases.  Catch this before the point of no
# return (switch_root deletes the initrd).
log "STAGE: pre-switch_root verification"
for link in sbin lib bin; do
    target=$(readlink "/newroot/$link" 2>/dev/null)
    if [ -n "$target" ]; then
        log "  /newroot/$link -> $target"
    else
        log "  WARN: /newroot/$link is not a symlink"
    fi
done

# Use the fully-resolved path to sidestep the Debian usrmerge symlink chain:
#   /sbin/init -> (sbin->usr/sbin) -> /usr/sbin/init -> /lib/systemd/systemd
#   -> (lib->usr/lib) -> /usr/lib/systemd/systemd
# Every hop is a potential ENOENT if a symlink is broken.
INIT=/usr/lib/systemd/systemd
if [ ! -x "/newroot${INIT}" ]; then
    log "WARN: ${INIT} not found, trying /sbin/init"
    INIT=/sbin/init
fi
if [ ! -x "/newroot${INIT}" ]; then
    log "ERROR: no init binary found on rootfs"
    ls -la /newroot/usr/lib/systemd/ 2>&1 | while read line; do log "    $line"; done
    ls -la /newroot/sbin/ 2>&1 | while read line; do log "    $line"; done
    fail "init binary not found on rootfs"
fi

# Verify the dynamic linker exists — the OTHER cause of ENOENT from exec()
if [ ! -f "/newroot/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1" ]; then
    log "ERROR: arm64 dynamic linker missing"
    fail "dynamic linker (ld-linux-aarch64.so.1) not found"
fi
log "  init=${INIT}, dynamic linker OK"

log "STAGE: switch_root /newroot $INIT"
exec switch_root /newroot $INIT || fail "switch_root failed"
