{
  "platform_runtime": "/usr",
  "resources": {
    "audio-devices": [
      "/dev/snd/controlC0",
      "/dev/snd/pcmC0D0p"
    ],
    "display-sockets": [
      "/run/pocketforge/session/wayland-0"
    ],
    "input-devices": [
      "/dev/input/pf-app-pad"
    ],
    "render-devices": [
      "/dev/dri/renderD128"
    ],
    "session-environment": [
      "/run/pocketforge/session/environment",
      "/dev/dri",
      "/sys/dev/char",
      "/sys/devices/platform",
      "/sys/class/drm",
      "/proc/cpuinfo",
      "/proc/sys/vm/overcommit_memory",
      "/dev/urandom",
      "/proc/meminfo",
      "/proc/stat",
      "/sys/devices/system/cpu"
    ],
    "x11-environment": [
      "/run/pocketforge/x11/policy/environment"
    ],
    "x11-socket": [
      "/run/pocketforge/x11/.X11-unix/X0"
    ]
  }
}
