# The Debian slim base below has no CA store, and apt reaches snapshot.debian.org over https
# with public-CA verification (a pf-public-ci runner cannot use the NAS apt cache, and the
# policy forbids a plain-http internet leg). Take the Mozilla bundle from a digest-pinned image
# pulled over the daemon's own verified https; it is not a package source.
FROM docker.io/library/alpine:3.22@sha256:bfe7ceb9f09ec0566c48fb93356e45a47a00be5a1dd14fa5b909e7709c66b034 AS pf-ca-bundle

FROM debian:bookworm-20260623-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df

ARG APT_SNAPSHOT_DATE=20260601T000000Z
ARG PF_IME_UID
ARG PF_IME_GID

COPY --from=pf-ca-bundle /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# The apt policy (https only, Retries 0 against CVE-2026-109518, fail-closed update, bounded
# steps) lives in the script so tests/test-ime-apt-install.sh can run it hermetically.
COPY install-tools.sh /usr/local/libexec/pf-ime-install-tools.sh

RUN case "${PF_IME_UID}:${PF_IME_GID}" in \
        *[!0-9:]*|*::*|:*|*:) echo 'PF_IME_UID and PF_IME_GID must be numeric' >&2; exit 1 ;; \
    esac \
    && printf 'pf-ime:x:%s:\n' "${PF_IME_GID}" >> /etc/group \
    && printf 'pf-ime:x:%s:%s:PocketForge input method:/nonexistent:/usr/sbin/nologin\n' \
        "${PF_IME_UID}" "${PF_IME_GID}" >> /etc/passwd \
    && awk -F: '$1 == "nobody" && $3 == "65534" { found=1 } END { exit !found }' /etc/passwd \
    && sh /usr/local/libexec/pf-ime-install-tools.sh "${APT_SNAPSHOT_DATE}" \
    && command -v dbus-daemon \
    && command -v dbus-send \
    && command -v xdg-dbus-proxy \
    && python3 -c 'import dbus, gi'
