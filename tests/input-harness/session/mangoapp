#!/bin/bash
# Trusted-client screenshot relay. gamescope --mangoapp launches the
# binary named "mangoapp" through gamescopereaper (--respawn), which
# hands each spawn a fresh trusted Wayland connection (WAYLAND_SOCKET
# fd). We block on a FIFO; each command is executed via `exec pf-shot`,
# consuming the trusted fd. pf-shot exits, the reaper respawns us with
# a fresh trusted fd, and we block on the FIFO again.
set -u

fifo="${PF_MANGO_FIFO:-/run/pf-mango.fifo}"

# One command per spawn; wait for the driver to request something.
if ! read -r -t "${PF_MANGO_WAIT_SECONDS:-600}" cmd < "$fifo"; then
	# Timeout or empty: exit so the reaper respawns a fresh trusted fd.
	exit 0
fi

set -- $cmd
verb="${1:-}"
case "$verb" in
	screenshot)
		path="${2:?screenshot needs a path}"
		type="${3:-4}"
		# pf-shot binds gamescope_control on this trusted connection
		# and waits for screenshot_taken (gamescopectl would drop
		# the type argument and return before the write).
		exec pf-shot "$path" "$type"
		;;
	*)
		echo "mangoapp: unknown command: $cmd" >&2
		exit 0
		;;
esac
