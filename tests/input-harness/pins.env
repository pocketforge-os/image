# Input harness pins. Sourced by run.sh and consumed as Containerfile ARGs.
# This 3a912201 pin is for the HEADLESS LAPTOP HARNESS only: gamescope#15 lets
# headless run without VK_KHR_external_semaphore_fd when lavapipe lacks it,
# while DRM scanout and explicit-sync paths still fail closed. The production
# device image remains at 298881e3 in its own provenance pipeline
# (scripts/gamescope_package.py + pocketforge-source-closure.tsv).
GAMESCOPE_URL=https://github.com/pocketforge-os/gamescope.git
GAMESCOPE_BRANCH=pocketforge-linear
GAMESCOPE_COMMIT=3a9122019a95d96721b3ed18f6088de8c7242c4f
# Source-closure edge wlroots-wayland-protocols from gamescope's manifest.
WAYLAND_PROTOCOLS_URL=https://github.com/pocketforge-os/wayland-protocols.git
WAYLAND_PROTOCOLS_COMMIT=aa62366fb800a0689f4e9de83811ff33f6a91f44
# Digest-pinned base image (house style, cf tests/session-authority-systemd).
BASE_IMAGE=debian@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
BASE_IMAGE_TAG=debian:trixie-slim
IMAGE_TAG=pocketforge/input-harness:tsp-ihne1.2
