[Unit]
Description=Fixture Gamescope filesystem-socket owner
Before=pocketforge-session-publisher.service
PartOf=pocketforge-gamescope-session.target
Conflicts=pf-shell-selected.service pocketforge-foreground.target
OnFailure=pocketforge-gamescope-fallback.service
OnSuccess=pocketforge-gamescope-fallback.service

[Service]
Type=notify
User=pf-gamescope
Group=pf-gamescope
RuntimeDirectory=pocketforge/gamescope
RuntimeDirectoryMode=0751
ExecStart=/usr/local/libexec/fake-gamescope
Restart=no
TimeoutStopSec=2s
