[Unit]
Description=PocketForge Gamescope display owner
After=dev-dri-renderD128.device pf-kbd-layout-env.service pf-open-gpu-gate.service pocketforge-boot-animator.service pf-shell-selected.service systemd-tmpfiles-setup.service
Wants=dev-dri-renderD128.device pf-kbd-layout-env.service
PartOf=pocketforge-gamescope-session.target
Conflicts=pf-shell-selected.service pocketforge-foreground.target
OnFailure=pocketforge-gamescope-fallback.service
OnSuccess=pocketforge-gamescope-fallback.service
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=simple
Slice=pocketforge-session.slice
OOMScoreAdjust=-900
User=pf-gamescope
Group=pf-gamescope
SupplementaryGroups=video render pf-compositor-input
RuntimeDirectory=pocketforge/gamescope
# App units traverse this directory to consume publisher-projected session
# sockets; files within it remain owned and access-controlled separately.
RuntimeDirectoryMode=0751
EnvironmentFile=-/run/pocketforge/kbd-layout.env
EnvironmentFile=-/run/pocketforge/gamescope/kms.env
Environment=XDG_RUNTIME_DIR=/run/pocketforge/gamescope
ExecStartPre=/usr/lib/pocketforge/pf-gamescope-kms-select
ExecStartPre=+/usr/bin/systemctl stop pocketforge-boot-animator.service pf-shell-selected.service
ExecStart=/usr/bin/gamescope --backend drm --prefer-drm ${PF_GAMESCOPE_KMS_NODE} --expose-wayland --xwayland-count 1
Restart=no
NoNewPrivileges=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
# Xwayland requires /tmp lock and socket paths. Map only its shared runtime tree;
# the publisher exposes the filesystem socket to separately sandboxed app units.
ReadWritePaths=/run/pocketforge/x11
BindPaths=/run/pocketforge/x11:/tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input rw
TimeoutStopSec=5s
