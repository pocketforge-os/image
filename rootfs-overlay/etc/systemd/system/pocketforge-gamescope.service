[Unit]
Description=PocketForge Gamescope display owner
After=dev-dri-renderD128.device pf-kbd-layout-env.service pf-open-gpu-gate.service pocketforge-boot-animator.service pf-shell-selected.service
Wants=dev-dri-renderD128.device pf-kbd-layout-env.service
PartOf=pocketforge-gamescope-session.target
Conflicts=pf-shell-selected.service pocketforge-foreground.target
OnFailure=pocketforge-gamescope-fallback.service
OnSuccess=pocketforge-gamescope-fallback.service
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=simple
User=pf-gamescope
Group=pf-gamescope
SupplementaryGroups=video render pf-compositor-input
RuntimeDirectory=pocketforge/gamescope
RuntimeDirectoryMode=0750
EnvironmentFile=-/run/pocketforge/kbd-layout.env
EnvironmentFile=-/run/pocketforge/gamescope/kms.env
Environment=XDG_RUNTIME_DIR=/run/pocketforge/gamescope
ExecStartPre=/usr/lib/pocketforge/pf-gamescope-kms-select
ExecStartPre=+/usr/bin/systemctl stop pocketforge-boot-animator.service pf-shell-selected.service
ExecStart=/usr/bin/gamescope --backend drm --prefer-drm ${PF_GAMESCOPE_KMS_NODE} --expose-wayland --xwayland-count 1
Restart=no
NoNewPrivileges=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input rw
TimeoutStopSec=5s
