[Unit]
Description=PocketForge Gamescope display owner
After=systemd-udev-settle.service pf-open-gpu-gate.service pocketforge-boot-animator.service pf-shell-selected.service
Wants=systemd-udev-settle.service
PartOf=pocketforge-gamescope-session.target
Conflicts=pf-shell-selected.service pocketforge-foreground.target
OnFailure=pocketforge-gamescope-fallback.service
OnSuccess=pocketforge-gamescope-fallback.service
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=simple
User=pf-gamescope
Group=pf-gamescope
SupplementaryGroups=video render pf-compositor-input
RuntimeDirectory=pocketforge/gamescope
RuntimeDirectoryMode=0750
Environment=XDG_RUNTIME_DIR=/run/pocketforge/gamescope
ExecStartPre=+/usr/bin/systemctl stop pocketforge-boot-animator.service pf-shell-selected.service
ExecStart=/usr/bin/gamescope --backend drm --expose-wayland --xwayland-count 1
Restart=no
NoNewPrivileges=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=char-input rw
TimeoutStopSec=5s
