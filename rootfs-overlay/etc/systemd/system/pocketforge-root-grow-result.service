[Unit]
Description=Report PocketForge first-boot root growth
ConditionPathExists=/etc/pocketforge-root-grow
Wants=cloud-final.service
After=cloud-final.service

[Service]
Type=oneshot
# This probe is read-only and deliberately returns success after logging a
# typed failure, so partition growth can never become a boot requirement.
ExecStart=/usr/lib/pocketforge/root-grow-result
TimeoutStartSec=30s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
