[Unit]
Description=PocketForge low-battery orderly shutdown policy
After=systemd-udev-trigger.service

[Service]
Type=oneshot
User=root
ConditionPathExists=/sys/class/power_supply/axp20x-battery
ExecStart=/usr/lib/pocketforge/low-battery-shutdown.sh
RuntimeDirectory=pocketforge-low-battery-shutdown
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=15s
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
PrivateDevices=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
