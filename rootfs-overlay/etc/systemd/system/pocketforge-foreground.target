# pocketforge-foreground.target — the exclusive foreground display-app slot.
#
# THE SEAM (tsp-ikk0.11, design ruled by tsp-3rd3-coord 2026-07-16): any app
# that takes the panel joins this target DECLARATIVELY — no per-app
# animator-kill hardcoding anywhere. An app unit (or a `pf-take-panel`
# transient unit) declares:
#
#     [Unit]
#     Requires=pocketforge-foreground.target
#     After=pocketforge-foreground.target
#
# Starting the app then:
#   1. activates this target, whose activation — via the animator's
#      Conflicts=/Before= on it — first STOPS pocketforge-boot-animator
#      (SIGTERM → clears fb0 to black → exit 0, the tsp-3rd3.4 contract),
#   2. and only then starts the app (After= orders it behind the stop),
#      so fb0 has exactly ONE writer at all times. This kills the
#      splash/app pan-fight on the double-buffered fb0 that the owner saw
#      as "z-fighting" (root cause proven in bead tsp-7kpp).
#
# StopWhenUnneeded: when the last joined app unit exits, the target
# deactivates on its own; OnSuccess then restores the previous owner, so the
# device returns to its steady-state UI. A brief black flash during handoff
# is ACCEPTED by design ruling — seamless splash→app handoff is deferred to
# tsp-3rd3.4.
#
# THE "KNOWN FUTURE EDGE" ABOVE IS NOW RESOLVED (bd: tsp-1cl7.1) — the MVP
# menu IS that persistent MainUI, and this is the launcher integration.
# WHICH unit is restored is now selected PER IMAGE by a drop-in, because the
# panel's owner is fixed at BUILD time by the enable-symlink swap in
# scripts/build-rootfs.sh (exactly one of animator/menu/placeholder is
# enabled). Hence there is no OnSuccess= below: the build installs exactly one
#     pocketforge-foreground.target.d/10-owner-{animator,menu}.conf
# alongside that UI's enable symlink. Read 10-owner-menu.conf before changing
# this — an OnSuccess= here that a drop-in "overrides" does NOT override,
# it MERGES (dependency settings cannot be reset by an empty assignment), and
# the slot then restores TWO fb0 writers.
#
# Conflicts=/After= on the ANIMATOR stay here: the animator must be stopped
# whenever the slot is taken on every image variant, so that half is not
# owner-dependent. The menu's Conflicts=/After= ride its own drop-in, so an
# animator-only image keeps exactly today's behaviour — `pf-take-panel ...
# testgles2` runs there daily for HIL and display verification, and a slot
# that tried to restore a menu which is not enabled would fail the restore,
# which reads as a display fault in precisely the evidence those runs collect.
#
# The launcher joining this target PERSISTENTLY is NOT the answer either: a
# unit that Requires= this target holds it active, so StopWhenUnneeded could
# never fire and the target could never stop the menu to hand fb0 over.
#
# bd: tsp-ikk0.11 (root cause: tsp-7kpp; design intent: tsp-3rd3.4;
#     launcher integration: tsp-1cl7.1, cross-ref tsp-y2di)

[Unit]
Description=PocketForge foreground display-app slot (exclusive fb0 ownership)
Documentation=https://github.com/pocketforge-os/image/tree/main/apps/pocketforge-boot-animator
DefaultDependencies=no
StopWhenUnneeded=yes
# OnSuccess= is deliberately ABSENT — it ships in the per-image
# 10-owner-{animator,menu}.conf drop-in (see the header). Do not inline it.
# The Conflicts=/After= on the animator MUST be declared HERE (target-side),
# not only animator-side: when this target is pulled in as a Requires=
# dependency of an app unit (systemd-run/pf-take-panel — the normal path!),
# systemd does NOT enforce the *conflicting unit's* declaration — the target
# activates and the animator keeps running (proven on-device AND in a local
# systemd repro, tsp-ikk0.11 window 2026-07-16; a direct `systemctl start`
# of the target DOES honor it, which is why the splash-handoff precedent
# never hit this). Target-side Conflicts= is enforced in the dependency-pull
# transaction; validated on-device via drop-in before landing.
Conflicts=pocketforge-boot-animator.service shutdown.target
After=pocketforge-boot-animator.service
Before=shutdown.target
