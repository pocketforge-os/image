[Unit]
Description=Cap PocketForge root growth below the self-flash v3 reserve
ConditionPathExists=/etc/pocketforge-selfflash-v3
After=local-fs.target

[Service]
Type=oneshot
# A growth refusal leaves OTA eligibility fail-closed and visible without
# placing this best-effort job on the cloud-init, network, or login path.
ExecStart=/usr/lib/pocketforge/self-flash-v3-grow
TimeoutStartSec=90s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
