[Unit]
Description=Cap PocketForge root growth below the self-flash v3 reserve
ConditionPathExists=/etc/pocketforge-selfflash-v3
After=local-fs.target
Before=cloud-init-local.service cloud-init.service ssh.service

[Service]
Type=oneshot
# Serialize control-slot initialization before SSH-based kit admission. The
# timeout bounds that barrier; failure is visible but is not a requirement.
ExecStart=/usr/lib/pocketforge/self-flash-v3-grow
TimeoutStartSec=90s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
