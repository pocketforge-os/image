# pocketforge-boot-animator.service — fb0 boot animator.
#
# Paints the tsp-3rd3.2 48-frame ember-sweep set on /dev/fb0 at 16 fps. On
# the open 7.x kernel (DRM fbdev) it rotates the 1280x720 scene by the DSI
# connector's "panel orientation" (kernel meaning; it paints nothing if that
# cannot be read); on the vendor 4.9 disp2 fb it keeps the pre-port pan path.
# It unbinds the framebuffer console by name first, so console text cannot
# bleed through. See apps/pocketforge-boot-animator/README.md.
#
# The animator runs until a successor takes fb0, and systemd stops it first:
#   - a boot-enabled panel owner (pf-shell-selected = MainUI, or the
#     menu/placeholder) stops it from its ExecStartPre, right before its own
#     ExecStart. The owner is NOT Conflicts= with the animator: both are in
#     the one boot transaction, and that Conflicts= made systemd delete this
#     unit's start job, so the animator never ran (bd tsp-3rd3.12);
#   - a foreground app or recovery, via pocketforge-foreground.target or its
#     own Conflicts= (never in the boot transaction).
# On SIGTERM it HOLDS the last frame (no clear) and exits 0; the successor's
# first present replaces the whole buffer, so there is no black gap (bd
# tsp-3rd3.6, design note section 3.5; supersedes the tsp-3rd3.4
# clear-to-black contract). With no successor it loops forever: the splash
# IS the state until then.
#
# It YIELDS to a live owner: every panel owner holds
# RuntimeDirectory=pocketforge-panel-owner/%N while starting/running, and
# ConditionDirectoryNotEmpty=! below makes a later start of this unit (e.g. a
# HIL script restoring "the animator") a skip rather than a second fb0 writer.
# At boot the directory is empty: owners start after basic.target, this unit
# before it.
#
# Ordering rationale (bd tsp-3rd3.6):
#   - DefaultDependencies=no and RequiresMountsFor= the frame set ONLY: it
#     starts as soon as PID 1 can reach its files. /dev/fb0 is a devtmpfs
#     node from kernel ~2.7 s; it no longer waits for udev coldplug to tag
#     dev-fb0.device (kernel ~6.7 s), nor for sysinit.target.
#   - ConditionPathExists=/dev/fb0: no fb, no animator (a skip, not a fail).
#   - Before=basic.target: pulled in early, never after login.
#   - Nothing may wait for it: Type=simple, and it asks for no one else.
#   - Nice=10 and the lowest best-effort I/O priority: under boot load it
#     drops frames (its schedule is absolute) instead of delaying boot.
#     Budget: after frame 000 only the 266x307 changed region is decoded
#     and blitted per tick (hermetic --measure test).
#   - Conflicts=pocketforge-splash-handoff.target pocketforge-foreground.target
#                                  — one systemctl start = one clean stop.
#
# bd: tsp-3rd3.4 (supersedes pocketforge-fb-clear / bd tsp-ooe), tsp-3rd3.6

[Unit]
Description=PocketForge boot animator (fb0 splash)
Documentation=https://github.com/pocketforge-os/image/tree/main/apps/pocketforge-boot-animator
DefaultDependencies=no
RequiresMountsFor=/opt/pocketforge/boot-anim/frames
Before=basic.target
# Two takeover seams stop the animator (both SIGTERM → hold last frame → exit 0):
#   - pocketforge-splash-handoff.target — the PERMANENT successor-UI handoff
#     (a future MainUI activates it once; the animator does not return).
#   - pocketforge-foreground.target — the TRANSIENT foreground-app slot
#     (tsp-ikk0.11): a display app joins it (Requires=/After=), the animator
#     stops BEFORE the app starts (single fb0 writer, no splash/app
#     pan-fight — root cause tsp-7kpp), and the target's OnSuccess restores
#     the animator when the last app exits. NOTE: the LOAD-BEARING
#     Conflicts=/After= for the dependency-pull path live on the TARGET
#     (see its unit file for why); the declarations below cover the
#     animator-anchor direction (starting the animator reclaims the slot).
Before=pocketforge-foreground.target
Conflicts=pocketforge-splash-handoff.target pocketforge-foreground.target shutdown.target
ConditionPathExists=/dev/fb0
ConditionPathExists=/opt/pocketforge/boot-anim/frames/frame-000.png
# Yield to a live panel owner (see the header; bd tsp-3rd3.12).
ConditionDirectoryNotEmpty=!/run/pocketforge-panel-owner

[Service]
Type=simple
# The default boot runs CLEAN — no per-tick journal chatter, no diagnostic
# argv. For the deliberate decode-timing measurement boot, install the drop-in
#   /etc/systemd/system/pocketforge-boot-animator.service.d/measure.conf
# (contents in apps/pocketforge-boot-animator/measure.conf.example on the
# image branch), `systemctl daemon-reload`, cold-POR, harvest `tick=` lines
# from `journalctl -u pocketforge-boot-animator -o cat`, then remove the
# drop-in + daemon-reload back to clean. tsp-3rd3.4 acceptance script does
# this end-to-end.
ExecStart=/opt/pocketforge/bin/pocketforge-boot-animator
# systemd default KillSignal=SIGTERM is exactly the handoff contract: the
# animator holds its last frame, unmaps fb0 and exits 0 within milliseconds.
KillSignal=SIGTERM
TimeoutStopSec=2s
Restart=no
# The animator is small and non-critical — keep the memory guardrail modest.
MemoryMax=32M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=basic.target
