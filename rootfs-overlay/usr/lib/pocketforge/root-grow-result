#!/usr/bin/python3
"""Emit one typed, non-fatal result for cloud-init root growth."""

from __future__ import annotations

import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from typing import Callable, Mapping, NamedTuple, TextIO


MARKER_PATH = Path("/etc/pocketforge-root-grow")
STATE_PATH = Path("/var/lib/pocketforge/root-grow-state")
SYS_BLOCK = Path("/sys/class/block")
SECTOR_BYTES = 512
GPT_BACKUP_SECTORS = 33
MAX_FILESYSTEM_SLACK_BYTES = 4095


class Outcome(NamedTuple):
    state: str
    reason: str


def _parse_assignments(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw_line in path.read_text(encoding="ascii").splitlines():
        if not raw_line or raw_line.startswith("#"):
            continue
        key, separator, value = raw_line.partition("=")
        if not separator or not key or not value or key in values:
            raise ValueError("invalid assignment")
        values[key] = value
    return values


def read_marker(path: Path) -> dict[str, int]:
    values = _parse_assignments(path)
    if set(values) != {
        "Schema",
        "BakedRootPartitionStartSector",
        "BakedRootPartitionSectors",
    }:
        raise ValueError("invalid marker fields")
    if values.get("Schema") != "pocketforge.root-grow/v1":
        raise ValueError("invalid marker schema")
    marker = {
        "baked_start_sector": int(values["BakedRootPartitionStartSector"]),
        "baked_sectors": int(values["BakedRootPartitionSectors"]),
    }
    if marker["baked_start_sector"] <= 0 or marker["baked_sectors"] <= 0:
        raise ValueError("invalid marker geometry")
    return marker


def read_prior_complete(path: Path) -> bool:
    try:
        values = _parse_assignments(path)
    except (OSError, UnicodeError, ValueError):
        return False
    return (
        values.get("Schema") == "pocketforge.root-grow-state/v1"
        and values.get("State") == "complete"
    )


def _read_positive_integer(path: Path) -> int:
    value = int(path.read_text(encoding="ascii").strip())
    if value <= 0:
        raise ValueError("non-positive sysfs geometry")
    return value


def _filesystem_bytes(device: Path) -> int:
    result = subprocess.run(
        ["/usr/sbin/dumpe2fs", "-h", str(device)],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=10,
    )
    block_count = None
    block_size = None
    for line in result.stdout.splitlines():
        match = re.match(r"^Block count:\s+(\d+)$", line)
        if match:
            block_count = int(match.group(1))
        match = re.match(r"^Block size:\s+(\d+)$", line)
        if match:
            block_size = int(match.group(1))
    if not block_count or not block_size:
        raise ValueError("missing ext4 geometry")
    return block_count * block_size


def probe_system(_marker: Mapping[str, int]) -> dict[str, int]:
    result = subprocess.run(
        ["/usr/bin/findmnt", "--noheadings", "--output", "SOURCE", "--target", "/"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=10,
    )
    device = Path(result.stdout.strip()).resolve()
    name = device.name
    block_path = (SYS_BLOCK / name).resolve()
    partition_number = _read_positive_integer(SYS_BLOCK / name / "partition")
    if partition_number != 5 or block_path.parent.name == name:
        raise ValueError("root is not partition 5")
    disk_name = block_path.parent.name
    return {
        "root_start_sector": _read_positive_integer(SYS_BLOCK / name / "start"),
        "root_sectors": _read_positive_integer(SYS_BLOCK / name / "size"),
        "disk_sectors": _read_positive_integer(SYS_BLOCK / disk_name / "size"),
        "filesystem_bytes": _filesystem_bytes(device),
    }


def classify(
    marker: Mapping[str, int],
    geometry: Mapping[str, int],
    *,
    prior_complete: bool,
) -> Outcome:
    baked_start = marker["baked_start_sector"]
    baked_sectors = marker["baked_sectors"]
    root_start = geometry["root_start_sector"]
    root_sectors = geometry["root_sectors"]
    disk_sectors = geometry["disk_sectors"]
    filesystem_bytes = geometry["filesystem_bytes"]

    if root_start != baked_start:
        return Outcome("failed", "root_start_mismatch")
    if root_sectors < baked_sectors:
        return Outcome("failed", "partition_shrunk")
    expected_end = disk_sectors - GPT_BACKUP_SECTORS
    root_end = root_start + root_sectors
    if root_end != expected_end:
        if root_sectors == baked_sectors and expected_end > root_end:
            return Outcome("failed", "partition_not_grown")
        return Outcome("failed", "partition_not_at_disk_end")

    partition_bytes = root_sectors * SECTOR_BYTES
    filesystem_slack = partition_bytes - filesystem_bytes
    if filesystem_slack < 0:
        return Outcome("failed", "filesystem_exceeds_partition")
    if filesystem_slack > MAX_FILESYSTEM_SLACK_BYTES:
        return Outcome("failed", "filesystem_not_grown")

    if prior_complete or root_sectors == baked_sectors:
        return Outcome("already", "complete")
    return Outcome("grown", "complete")


def write_complete(path: Path, geometry: Mapping[str, int]) -> None:
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    payload = (
        "Schema=pocketforge.root-grow-state/v1\n"
        "State=complete\n"
        f"RootPartitionSectors={geometry['root_sectors']}\n"
        f"FilesystemBytes={geometry['filesystem_bytes']}\n"
    )
    temporary_name = ""
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="ascii",
            dir=path.parent,
            prefix=".root-grow-state.",
            delete=False,
        ) as temporary:
            temporary_name = temporary.name
            temporary.write(payload)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary_name and os.path.exists(temporary_name):
            os.unlink(temporary_name)


def _emit(output: TextIO, outcome: Outcome) -> None:
    output.write(f"PF_ROOT_GROW state={outcome.state} reason={outcome.reason}\n")
    output.flush()


def run(
    *,
    probe: Callable[[Mapping[str, int]], Mapping[str, int]] = probe_system,
    marker_path: Path = MARKER_PATH,
    state_path: Path = STATE_PATH,
    output: TextIO = sys.stdout,
) -> int:
    try:
        marker = read_marker(marker_path)
    except (KeyError, OSError, UnicodeError, ValueError):
        _emit(output, Outcome("failed", "marker_invalid"))
        return 0

    try:
        geometry = probe(marker)
    except (KeyError, OSError, subprocess.SubprocessError, UnicodeError, ValueError):
        _emit(output, Outcome("failed", "probe_failed"))
        return 0

    try:
        outcome = classify(
            marker,
            geometry,
            prior_complete=read_prior_complete(state_path),
        )
    except (KeyError, TypeError, ValueError):
        _emit(output, Outcome("failed", "classification_failed"))
        return 0
    if outcome.state in ("grown", "already"):
        try:
            write_complete(state_path, geometry)
        except OSError:
            outcome = Outcome("failed", "state_write_failed")
    _emit(output, outcome)
    return 0


if __name__ == "__main__":
    raise SystemExit(run())
