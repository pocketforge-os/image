#!/usr/bin/python3
"""Grow the validated SD root exactly to the self-flash v3 tail boundary."""

from __future__ import annotations

import argparse
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import stat
import struct
import subprocess
import sys
from typing import BinaryIO, Callable, Mapping, Sequence


HERE = Path(__file__).resolve().parent
STAGE_HELPER = HERE / "self-flash-v3-stage"
MARKER_PATH = Path("/etc/pocketforge-selfflash-v3")
RECEIPT_PATH = Path("/var/lib/pocketforge/self-flash-v3-growth")
SLOT_BYTES = 65_536
LOGICAL_SECTOR_BYTES = 512
RESERVE_BYTES = 1_073_741_824
ALIGNMENT_BYTES = 4_194_304
GUARD_BYTES = 4_194_304
CONTROL_BYTES = 4_194_304
MARKER_KEYS = (
    "Schema",
    "ContractSHA256",
    "CardController",
    "AlignmentBytes",
    "ReserveBytes",
    "GuardBytes",
    "ControlBytes",
    "SeedMaxBytes",
    "SlotBytes",
    "BakedRootPartitionStartSector",
    "BakedRootPartitionSectors",
)
RECEIPT_KEYS = (
    "Schema",
    "State",
    "Generation",
    "TargetDescriptorSHA256",
    "TargetRawSHA256",
    "TargetRawBytes",
    "CompressedExpectedSHA256",
    "CompressedExpectedBytes",
    "CompressedVerifiedHost",
    "CompressedHostVerification",
    "DUTCompressedHash",
    "XzIntegrity",
    "RawStreamSHA256",
    "RawStreamBytes",
    "RawStreamHashMatch",
    "RawStreamCountMatch",
    "WriteMethod",
    "WriteResult",
    "FullDeviceReadback",
    "SeedResult",
    "StampResult",
    "FailurePhase",
    "FailureReason",
    "InitrdStartMonotonicMs",
    "WriteStartMonotonicMs",
    "WriteEndMonotonicMs",
    "SeedEndMonotonicMs",
    "StampEndMonotonicMs",
    "ReceiptWrittenMonotonicMs",
    "ReceiptRecordSHA256",
)


class Refusal(RuntimeError):
    """A fail-closed refusal safe to report as a bounded token."""


def _load_stage_helper():
    loader = importlib.machinery.SourceFileLoader("self_flash_v3_stage_runtime", str(STAGE_HELPER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise Refusal("stage_helper_import_failed")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _positive(name: str, value: object) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise Refusal(f"{name}_invalid")
    if value > (1 << 63) - 1:
        raise Refusal(f"{name}_overflow")
    return value


def _tail_start(card_bytes: int) -> int:
    card_bytes = _positive("card_bytes", card_bytes)
    if card_bytes % LOGICAL_SECTOR_BYTES or card_bytes <= RESERVE_BYTES:
        raise Refusal("card_geometry_invalid")
    return ((card_bytes - RESERVE_BYTES) // ALIGNMENT_BYTES) * ALIGNMENT_BYTES


def derive_growth_plan(
    *,
    card_bytes: int,
    partitions: Sequence[Mapping[str, int]],
    baked_start_sector: int,
    baked_sectors: int,
) -> dict[str, int | bool]:
    """Accept only baked or already-capped p5 geometry and derive the one target."""
    baked_start_sector = _positive("baked_start_sector", baked_start_sector)
    baked_sectors = _positive("baked_sectors", baked_sectors)
    tail_start = _tail_start(card_bytes)
    target_end_sector = tail_start // LOGICAL_SECTOR_BYTES
    baked_end_sector = baked_start_sector + baked_sectors
    if baked_end_sector >= target_end_sector:
        raise Refusal("reserve_too_small_for_baked_root")

    normalized: list[tuple[int, int, int]] = []
    seen: set[int] = set()
    root: tuple[int, int, int] | None = None
    for item in partitions:
        number = _positive("partition_number", item.get("number"))
        start = _positive("partition_start_sector", item.get("start_sector"))
        sectors = _positive("partition_sectors", item.get("sectors"))
        end = start + sectors
        if number in seen or end > target_end_sector:
            raise Refusal("partition_geometry_invalid")
        seen.add(number)
        normalized.append((start, end, number))
        if number == 5:
            root = (start, end, number)
    if root is None:
        raise Refusal("root_partition_missing")
    if root[0] != baked_start_sector:
        raise Refusal("root_partition_start_mismatch")
    if root[1] not in (baked_end_sector, target_end_sector):
        raise Refusal("root_partition_unexpected_size")
    previous_end = 0
    for start, end, _number in sorted(normalized):
        if start < previous_end:
            raise Refusal("partition_overlap")
        previous_end = end

    return {
        "tail_start": tail_start,
        "before_end_sector": root[1],
        "after_end_sector": target_end_sector,
        "target_sectors": target_end_sector - baked_start_sector,
        "needs_partition_growth": root[1] == baked_end_sector,
        "control_end": ((card_bytes - GUARD_BYTES) // ALIGNMENT_BYTES) * ALIGNMENT_BYTES,
        "arm_offset": ((card_bytes - GUARD_BYTES) // ALIGNMENT_BYTES) * ALIGNMENT_BYTES - CONTROL_BYTES,
        "receipt_offset": ((card_bytes - GUARD_BYTES) // ALIGNMENT_BYTES) * ALIGNMENT_BYTES - CONTROL_BYTES + SLOT_BYTES,
    }


def initialize_control_slots(
    device: BinaryIO,
    *,
    arm_offset: int,
    receipt_offset: int,
    sync: Callable[[], None],
) -> str:
    device.seek(receipt_offset)
    existing_receipt = device.read(SLOT_BYTES)
    if len(existing_receipt) != SLOT_BYTES:
        raise Refusal("receipt_slot_read_short")
    if _valid_receipt_slot(existing_receipt):
        return "preserved-valid-receipt"
    zeroes = bytes(SLOT_BYTES)
    for name, offset in (("arm", arm_offset), ("receipt", receipt_offset)):
        if offset < 0 or offset % LOGICAL_SECTOR_BYTES:
            raise Refusal(f"{name}_slot_alignment")
        device.seek(offset)
        if device.write(zeroes) != SLOT_BYTES:
            raise Refusal(f"{name}_slot_write_short")
    device.flush()
    sync()
    for name, offset in (("arm", arm_offset), ("receipt", receipt_offset)):
        device.seek(offset)
        if device.read(SLOT_BYTES) != zeroes:
            raise Refusal(f"{name}_slot_readback_mismatch")
    return "zeroed-and-read-back"


def _valid_receipt_slot(content: bytes) -> bool:
    if len(content) != SLOT_BYTES:
        return False
    terminator = content.find(b"\n\n")
    if terminator < 0 or any(content[terminator + 2 :]):
        return False
    try:
        lines = content[:terminator].decode("ascii").splitlines()
    except UnicodeDecodeError:
        return False
    pairs: list[tuple[str, str]] = []
    for line in lines:
        if "=" not in line:
            return False
        pairs.append(tuple(line.split("=", 1)))
    if tuple(key for key, _value in pairs) != RECEIPT_KEYS:
        return False
    record = dict(pairs)
    if record["Schema"] != "pocketforge.self-flash-receipt/v3":
        return False
    if record["State"] not in ("ready", "started", "failed", "pass"):
        return False
    generation = record["Generation"]
    if len(generation) != 32 or any(character not in "0123456789abcdef" for character in generation):
        return False
    expected_digest = record["ReceiptRecordSHA256"]
    if len(expected_digest) != 64 or any(character not in "0123456789abcdef" for character in expected_digest):
        return False
    prefix = "".join(f"{key}={value}\n" for key, value in pairs[:-1]).encode("ascii")
    import hashlib

    return hashlib.sha256(prefix).hexdigest() == expected_digest


def build_growth_receipt(
    *,
    contract_sha256: str,
    card_serial: str,
    card_bytes: int,
    root_start_sector: int,
    before_end_sector: int,
    after_end_sector: int,
    tail_start: int,
    filesystem_bytes_before: int,
    filesystem_bytes_after: int,
    control_slots_initialized: str = "zeroed-and-read-back",
) -> dict[str, object]:
    return {
        "Schema": "pocketforge.self-flash-growth/v3",
        "ContractSHA256": contract_sha256,
        "CardController": "04020000",
        "CardType": "SD",
        "CardSerial": card_serial,
        "CardBytes": card_bytes,
        "LogicalSectorBytes": LOGICAL_SECTOR_BYTES,
        "RootPartitionStartSector": root_start_sector,
        "BeforeEndSector": before_end_sector,
        "AfterEndSector": after_end_sector,
        "TailStart": tail_start,
        "FilesystemBytesBefore": filesystem_bytes_before,
        "FilesystemBytesAfter": filesystem_bytes_after,
        "GPTRelocation": "pass",
        "PartitionGrowth": "pass",
        "PartitionTableReread": "pass",
        "Ext4Growth": "pass",
        "ControlSlotsInitialized": control_slots_initialized,
    }


def _read_marker() -> dict[str, str]:
    stage = _load_stage_helper()
    try:
        info = MARKER_PATH.lstat()
        lines = MARKER_PATH.read_text(encoding="ascii").splitlines()
    except (OSError, UnicodeError) as error:
        raise Refusal("marker_unreadable") from error
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise Refusal("marker_not_root_owned")
    pairs: list[tuple[str, str]] = []
    for line in lines:
        if "=" not in line:
            raise Refusal("marker_malformed")
        pairs.append(tuple(line.split("=", 1)))
    if tuple(key for key, _value in pairs) != MARKER_KEYS:
        raise Refusal("marker_fields_invalid")
    marker = dict(pairs)
    expected = {
        "Schema": "pocketforge.self-flash-capability/v3",
        "CardController": stage.CONTROLLER,
        "AlignmentBytes": str(ALIGNMENT_BYTES),
        "ReserveBytes": str(RESERVE_BYTES),
        "GuardBytes": str(GUARD_BYTES),
        "ControlBytes": str(CONTROL_BYTES),
        "SeedMaxBytes": str(stage.SEED_MAX_BYTES),
        "SlotBytes": str(SLOT_BYTES),
    }
    if any(marker.get(key) != value for key, value in expected.items()):
        raise Refusal("marker_mismatch")
    stage._sha("ContractSHA256", marker["ContractSHA256"])
    _positive("baked_start", int(marker["BakedRootPartitionStartSector"], 10))
    _positive("baked_sectors", int(marker["BakedRootPartitionSectors"], 10))
    return marker


def _run_checked(args: Sequence[str], *, input_text: str | None = None) -> str:
    result = subprocess.run(
        args,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        raise Refusal(f"tool_failed_{Path(args[0]).name}")
    return result.stdout


def _filesystem_bytes(device: str) -> int:
    output = _run_checked(["/usr/sbin/dumpe2fs", "-h", device])
    values: dict[str, int] = {}
    for line in output.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        if key in ("Block count", "Block size"):
            try:
                values[key] = int(value.strip(), 10)
            except ValueError as error:
                raise Refusal("ext4_geometry_invalid") from error
    if set(values) != {"Block count", "Block size"}:
        raise Refusal("ext4_geometry_missing")
    return values["Block count"] * values["Block size"]


def _verify_backup_gpt(device: BinaryIO, card_bytes: int, control_end: int) -> None:
    header_offset = card_bytes - LOGICAL_SECTOR_BYTES
    if header_offset < control_end:
        raise Refusal("backup_gpt_outside_guard")
    device.seek(header_offset)
    header = device.read(LOGICAL_SECTOR_BYTES)
    if len(header) != LOGICAL_SECTOR_BYTES or header[:8] != b"EFI PART":
        raise Refusal("backup_gpt_missing")
    current_lba, alternate_lba = struct.unpack_from("<QQ", header, 24)
    if current_lba != card_bytes // LOGICAL_SECTOR_BYTES - 1 or alternate_lba != 1:
        raise Refusal("backup_gpt_location_invalid")


def _write_receipt(receipt: Mapping[str, object]) -> None:
    RECEIPT_PATH.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = RECEIPT_PATH.with_name(RECEIPT_PATH.name + ".new")
    data = (json.dumps(receipt, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, RECEIPT_PATH)
        directory = os.open(RECEIPT_PATH.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except BaseException:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise


def grow() -> dict[str, object]:
    stage = _load_stage_helper()
    marker = _read_marker()
    selected = stage.select_sd(stage._discover_cards(), root_major_minor=stage._root_major_minor())
    plan = derive_growth_plan(
        card_bytes=int(selected["bytes"]),
        partitions=selected["partitions"],
        baked_start_sector=int(marker["BakedRootPartitionStartSector"]),
        baked_sectors=int(marker["BakedRootPartitionSectors"]),
    )
    device_path = str(selected["path"])
    partition_path = f"{device_path}p5"
    filesystem_before = _filesystem_bytes(partition_path)
    with open(device_path, "r+b", buffering=0) as device:
        fcntl.flock(device.fileno(), fcntl.LOCK_EX)
        if plan["needs_partition_growth"]:
            _run_checked(["/usr/sbin/sfdisk", "--relocate", "gpt-bak-std", device_path])
            definition = f"start={marker['BakedRootPartitionStartSector']}, size={plan['target_sectors']}\n"
            _run_checked(
                [
                    "/usr/sbin/sfdisk",
                    "--no-reread",
                    "--no-tell-kernel",
                    "--force",
                    "-N",
                    "5",
                    device_path,
                ],
                input_text=definition,
            )
            _run_checked(["/usr/bin/partx", "--update", "--nr", "5", device_path])
        refreshed = stage.select_sd(stage._discover_cards(), root_major_minor=stage._root_major_minor())
        verified = derive_growth_plan(
            card_bytes=int(refreshed["bytes"]),
            partitions=refreshed["partitions"],
            baked_start_sector=int(marker["BakedRootPartitionStartSector"]),
            baked_sectors=int(marker["BakedRootPartitionSectors"]),
        )
        if verified["needs_partition_growth"]:
            raise Refusal("partition_table_reread_stale")
        _run_checked(["/usr/sbin/resize2fs", partition_path])
        filesystem_after = _filesystem_bytes(partition_path)
        expected_filesystem_bytes = int(plan["tail_start"]) - int(marker["BakedRootPartitionStartSector"]) * 512
        if filesystem_after > expected_filesystem_bytes or filesystem_after < filesystem_before:
            raise Refusal("ext4_growth_out_of_bounds")
        _verify_backup_gpt(device, int(selected["bytes"]), int(plan["control_end"]))
        control_slots_initialized = initialize_control_slots(
            device,
            arm_offset=int(plan["arm_offset"]),
            receipt_offset=int(plan["receipt_offset"]),
            sync=lambda: os.fsync(device.fileno()),
        )

    receipt = build_growth_receipt(
        contract_sha256=marker["ContractSHA256"],
        card_serial=str(selected["serial"]),
        card_bytes=int(selected["bytes"]),
        root_start_sector=int(marker["BakedRootPartitionStartSector"]),
        before_end_sector=int(plan["before_end_sector"]),
        after_end_sector=int(plan["after_end_sector"]),
        tail_start=int(plan["tail_start"]),
        filesystem_bytes_before=filesystem_before,
        filesystem_bytes_after=filesystem_after,
        control_slots_initialized=control_slots_initialized,
    )
    _write_receipt(receipt)
    return receipt


def make_argument_parser() -> argparse.ArgumentParser:
    return argparse.ArgumentParser(description=__doc__)


def main() -> int:
    make_argument_parser().parse_args()
    if os.geteuid() != 0:
        print("PF_SELF_FLASH_V3_GROW state=REFUSED reason=not_root", file=sys.stderr)
        return 2
    try:
        receipt = grow()
    except (OSError, Refusal, ValueError) as error:
        reason = str(error) if isinstance(error, Refusal) else "io_or_value_error"
        print(f"PF_SELF_FLASH_V3_GROW state=REFUSED reason={reason}", file=sys.stderr)
        return 2
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    print("PF_SELF_FLASH_V3_GROW state=PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
